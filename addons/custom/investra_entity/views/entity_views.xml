<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_entity_list" model="ir.ui.view">
        <field name="name">investra.entity.list</field>
        <field name="model">investra.entity</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="entity_type"/>
                <field name="framework"/>
                <field name="currency_id"/>
                <field name="rate_source"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>
    <record id="view_entity_search" model="ir.ui.view">
        <field name="name">investra.entity.search</field>
        <field name="model">investra.entity</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="founder_id"/>
                <group>
                    <filter name="group_by_entity_type" string="Typ" context="{'group_by': 'entity_type'}"/>
                    <filter name="group_by_framework" string="Účetní rámec" context="{'group_by': 'framework'}"/>
                    <filter name="group_by_parent" string="Nadřazená kniha" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_entity" model="ir.actions.act_window">
        <field name="name">Účetní knihy</field>
        <field name="res_model">investra.entity</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_entity_search"/>
    </record>
    <menuitem id="menu_root" name="Investra" web_icon="account,static/description/icon.png" groups="account.group_account_readonly"/>
    <menuitem id="menu_valuation_section" name="Ocenění" parent="menu_root" sequence="10"/>
    <menuitem id="menu_reports" name="Výkazy" parent="menu_root" sequence="40"/>
    <menuitem id="menu_setup" name="Nastavení" parent="menu_root" sequence="90"/>
    <menuitem id="menu_setup_funds" name="Fondy" parent="menu_setup" sequence="10"/>
    <menuitem id="menu_setup_instruments" name="Nástroje" parent="menu_setup" sequence="20"/>
    <menuitem id="menu_setup_cnb" name="ČNB" parent="menu_setup" sequence="30"/>
    <menuitem id="menu_setup_audit" name="Auditní stopa" parent="menu_setup" sequence="40"/>
    <menuitem id="menu_entity" name="Účetní knihy" parent="menu_setup_funds" action="action_entity" sequence="20"/>
</odoo>
