<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fund_dashboard_kanban" model="ir.ui.view">
        <field name="name">investra.fund.dashboard.kanban</field><field name="model">investra.fund</field><field name="priority">50</field>
        <field name="arch" type="xml">
            <!-- Karta podle schváleného návrhu docs/vzhled/navrh-prehledu-fondu.html, styly fund_dashboard.scss.
                 Data a stavy počítá model (rozhodnutí 2026-11-14 „Přehled fondů – data a stavy karty“), šablona jen
                 vybírá třídu podle stavu. Celkový stav karty návrh nemá; výjimky jsou v části Kontroly. -->
            <kanban create="false" group_create="false" class="o_investra_fund_kanban" js_class="investra_fund_dashboard">
                <field name="currency_id"/>
                <field name="dashboard_valuation_id"/><field name="dashboard_exception_count"/>
                <field name="dashboard_result"/><field name="dashboard_has_result"/>
                <field name="dashboard_net_flow"/><field name="dashboard_lock_text"/><field name="dashboard_lock_exception_count"/>
                <field name="dashboard_latest_published"/>
                <field name="dashboard_next_valuation"/><field name="dashboard_next_valuation_id"/><field name="dashboard_next_state"/>
                <field name="dashboard_next_version"/>
                <field name="dashboard_deadline_state"/><field name="dashboard_todo"/>
                <templates>
                    <t t-name="card">
                        <a type="object" name="action_open_fund" class="o_investra_fund_name">
                            <field name="name"/>
                        </a>
                        <div class="o_investra_fund_row">
                            <div>
                                <span class="o_investra_label">FK</span>
                                <field name="dashboard_capital" class="o_investra_amount"/>
                            </div>
                            <div>
                                <span class="o_investra_label">Výsledek za období</span>
                                <t t-if="record.dashboard_has_result.raw_value">
                                    <span t-attf-class="o_investra_amount {{ record.dashboard_result.raw_value &gt; 0 ? 'o_investra_positive' : record.dashboard_result.raw_value &lt; 0 ? 'o_investra_negative' : '' }}">
                                        <t t-if="record.dashboard_result.raw_value &gt; 0">+</t><field name="dashboard_result"/>
                                    </span>
                                    <field name="dashboard_result_period" class="o_investra_period"/>
                                </t>
                                <span t-else="" class="o_investra_amount">—</span>
                            </div>
                        </div>
                        <!-- Úpisy − odkupy za období výsledku a uzávěrka knihy (rozhodnutí 2026-11-15). -->
                        <div class="o_investra_fund_row">
                            <div>
                                <span class="o_investra_label">Úpisy − odkupy</span>
                                <t t-if="record.dashboard_has_result.raw_value">
                                    <span t-attf-class="o_investra_amount {{ record.dashboard_net_flow.raw_value &gt; 0 ? 'o_investra_positive' : record.dashboard_net_flow.raw_value &lt; 0 ? 'o_investra_negative' : '' }}">
                                        <t t-if="record.dashboard_net_flow.raw_value &gt; 0">+</t><field name="dashboard_net_flow"/>
                                    </span>
                                </t>
                                <span t-else="" class="o_investra_amount">—</span>
                            </div>
                            <div>
                                <span class="o_investra_label">Uzávěrka</span>
                                <div t-if="record.dashboard_lock_text.raw_value" class="o_investra_value_row">
                                    <span class="o_investra_deadline">Uzamčeno do</span>
                                    <field name="dashboard_lock_text" class="o_investra_date"/>
                                    <span t-if="record.dashboard_lock_exception_count.raw_value" class="o_investra_pill o_investra_warning">Výjimky: <field name="dashboard_lock_exception_count"/></span>
                                </div>
                                <span t-else="">bez zámku</span>
                            </div>
                        </div>
                        <div class="o_investra_fund_row">
                            <div>
                                <span class="o_investra_label">Poslední ocenění</span>
                                <div t-if="record.dashboard_valuation_id.raw_value" class="o_investra_value_row">
                                    <field name="dashboard_date_text" class="o_investra_date"/>
                                    <a type="object" name="action_open_valuation"
                                       t-attf-class="o_investra_pill {{ record.dashboard_latest_published.raw_value ? 'o_investra_done' : 'o_investra_pending' }}">
                                        <field name="dashboard_state"/>
                                    </a>
                                </div>
                                <span t-else="">—</span>
                            </div>
                            <div>
                                <span class="o_investra_label">Další ocenění</span>
                                <div t-if="record.dashboard_next_valuation.raw_value" class="o_investra_value_row">
                                    <field name="dashboard_next_text" class="o_investra_date"/>
                                    <a t-if="record.dashboard_next_valuation_id.raw_value" type="object" name="action_open_next_valuation"
                                       class="o_investra_pill o_investra_pending">
                                        <field name="dashboard_next_state"/><t t-if="record.dashboard_next_version.raw_value &gt; 1"> · v<t t-out="record.dashboard_next_version.raw_value"/></t>
                                    </a>
                                    <t t-else="">
                                        <span class="o_investra_pill o_investra_pending"><field name="dashboard_next_state"/></span>
                                        <!-- ZJ-06 bod 3: ocenění se dá založit přímo z karty. -->
                                        <a type="object" name="action_create_next_valuation" class="o_investra_link_control">Založit ocenění</a>
                                    </t>
                                </div>
                                <span t-else="">—</span>
                            </div>
                        </div>
                        <div class="o_investra_fund_row">
                            <div>
                                <t t-if="record.dashboard_deadline_state.raw_value">
                                    <a type="object" name="action_open_deadlines" class="o_investra_report_name o_investra_link_deadline">
                                        <field name="dashboard_next_deadline"/>
                                    </a>
                                    <div class="o_investra_value_row">
                                        <span t-if="record.dashboard_deadline_state.raw_value == 'submitted'" class="o_investra_pill o_investra_done">Podáno</span>
                                        <span t-if="record.dashboard_deadline_state.raw_value == 'open'" class="o_investra_pill o_investra_warning">Otevřeno</span>
                                        <span t-if="record.dashboard_deadline_state.raw_value == 'overdue'" class="o_investra_pill o_investra_late">Po lhůtě</span>
                                        <span class="o_investra_deadline">Termín <field name="dashboard_deadline_due"/></span>
                                    </div>
                                </t>
                                <t t-else="">
                                    <span class="o_investra_label">ČNB</span>
                                    <span>bez termínu</span>
                                </t>
                            </div>
                            <div>
                                <span class="o_investra_label">Kontroly</span>
                                <span t-if="!record.dashboard_exception_count.raw_value" class="o_investra_control_ok">bez výjimky</span>
                                <a t-else="" type="object" name="action_open_checks" class="o_investra_control_warning o_investra_link_control">
                                    <field name="dashboard_exceptions"/>
                                </a>
                            </div>
                        </div>
                        <!-- Ke zpracování: položky a odkazy počítá model, widget je jen vykreslí. -->
                        <div class="o_investra_fund_row o_investra_fund_row_full">
                            <widget name="investra_fund_todo"/>
                        </div>
                        <!-- Odkaz „Otevřít ocenění“ odstraněn (uživatel 2026-11-15): ocenění otevře štítek stavu. -->
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_fund_dashboard_list" model="ir.ui.view">
        <field name="name">investra.fund.dashboard.list</field><field name="model">investra.fund</field><field name="priority">50</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="id" optional="hide"/>
                <field name="name"/><field name="dashboard_status" widget="badge" decoration-success="dashboard_status == 'ok'" decoration-warning="dashboard_status == 'warning'" decoration-danger="dashboard_status == 'danger'" decoration-muted="dashboard_status == 'none'"/><field name="dashboard_date"/><field name="dashboard_state"/>
                <field name="currency_id" column_invisible="1"/><field name="dashboard_capital"/>
                <field name="dashboard_has_result" column_invisible="1"/>
                <field name="dashboard_result" optional="show" invisible="not dashboard_has_result"/><field name="dashboard_net_flow" optional="show" invisible="not dashboard_has_result"/><field name="dashboard_lock_text" optional="hide"/><field name="dashboard_result_period" optional="hide"/>
                <field name="dashboard_published" optional="show"/>
                <field name="dashboard_next_valuation"/>
                <field name="dashboard_next_state" widget="badge" decoration-info="dashboard_next_state in ('draft', 'computed', 'none')" decoration-warning="dashboard_next_state in ('submitted', 'approved')"/>
                <field name="dashboard_todo_count" string="Ke zpracování" optional="show"/><field name="dashboard_my_todo" string="Můj krok" widget="boolean" optional="show"/>
                <field name="dashboard_next_deadline"/><field name="dashboard_deadline_state" widget="badge" decoration-warning="dashboard_deadline_state == 'open'" decoration-danger="dashboard_deadline_state == 'overdue'" decoration-success="dashboard_deadline_state == 'submitted'"/><field name="dashboard_exception_count"/>
            </list>
        </field>
    </record>
    <record id="view_valuation_check_dashboard_list" model="ir.ui.view">
        <field name="name">investra.valuation.check.dashboard.list</field><field name="model">investra.valuation.check</field><field name="priority">50</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="id" optional="hide"/>
                <field name="valuation_id"/><field name="name"/><field name="status" widget="badge" decoration-success="status == 'ok'" decoration-warning="status == 'warning'" decoration-danger="status == 'stop'"/><field name="detail"/>
            </list>
        </field>
    </record>
    <!-- Seznam smluvních toků pro položku „Splátky a kupóny do 7 dnů“; model jiný samostatný seznam nemá. -->
    <record id="view_cashflow_dashboard_list" model="ir.ui.view">
        <field name="name">investra.instrument.cashflow.dashboard.list</field><field name="model">investra.instrument.cashflow</field><field name="priority">50</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="id" optional="hide"/>
                <field name="date"/><field name="instrument_id"/><field name="flow_type"/><field name="amount"/>
            </list>
        </field>
    </record>
    <record id="view_fund_dashboard_search" model="ir.ui.view">
        <field name="name">investra.fund.dashboard.search</field><field name="model">investra.fund</field><field name="priority">50</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="filter_my_todo" string="Čeká na můj krok" domain="[('dashboard_my_todo', '=', True)]"/>
                <separator/>
                <filter name="filter_danger" string="Vyžaduje zásah" domain="[('dashboard_status', '=', 'danger')]"/>
                <filter name="filter_warning" string="Upozornění" domain="[('dashboard_status', '=', 'warning')]"/>
                <separator/>
                <filter name="filter_deadline_overdue" string="Termín ČNB po lhůtě" domain="[('dashboard_deadline_state', '=', 'overdue')]"/>
                <filter name="filter_deadline_open" string="Termín ČNB otevřený" domain="[('dashboard_deadline_state', 'in', ['open', 'overdue'])]"/>
                <filter name="filter_none" string="Bez ocenění" domain="[('dashboard_status', '=', 'none')]"/>
            </search>
        </field>
    </record>
    <record id="action_fund_dashboard" model="ir.actions.act_window">
        <field name="name">Přehled fondů</field><field name="res_model">investra.fund</field><field name="view_mode">kanban,list</field>
        <field name="search_view_id" ref="view_fund_dashboard_search"/>
        <!-- Karty od nejnaléhavějších (web_search_read v modelu). -->
        <field name="context">{'investra_dashboard_order': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_fund_dashboard_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_fund_dashboard_list')})]"/>
    </record>
    <record id="view_deadline_list" model="ir.ui.view">
        <field name="name">investra.regulatory.deadline.list</field><field name="model">investra.regulatory.deadline</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="id" optional="hide"/>
                <field name="fund_id"/><field name="report"/><field name="period_end"/><field name="due_date"/><field name="state" widget="badge" decoration-warning="state == 'open' and due_date &gt;= current_date" decoration-danger="state == 'open' and due_date &lt; current_date" decoration-success="state == 'submitted'"/><field name="source"/>
            </list>
        </field>
    </record>
    <record id="view_deadline_search" model="ir.ui.view">
        <field name="name">investra.regulatory.deadline.search</field><field name="model">investra.regulatory.deadline</field>
        <field name="arch" type="xml">
            <search>
                <field name="fund_id"/>
                <field name="report"/>
                <filter name="filter_open" string="Otevřeno" domain="[('state', '=', 'open')]"/>
                <filter name="filter_submitted" string="Podáno" domain="[('state', '=', 'submitted')]"/>
                <separator/>
                <filter name="filter_due_date" date="due_date" string="Termín"/>
                <group>
                    <filter name="group_by_fund" string="Fond" context="{'group_by': 'fund_id'}"/>
                    <filter name="group_by_report" string="Výkaz" context="{'group_by': 'report'}"/>
                    <filter name="group_by_state" string="Stav" context="{'group_by': 'state'}"/>
                    <filter name="group_by_due_date_month" string="Měsíc termínu" context="{'group_by': 'due_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_deadline" model="ir.actions.act_window">
        <field name="name">Termíny ČNB</field><field name="res_model">investra.regulatory.deadline</field><field name="view_mode">list</field>
        <field name="search_view_id" ref="view_deadline_search"/>
    </record>
    <menuitem id="menu_fund_dashboard" name="Přehled" parent="investra_entity.menu_root" action="action_fund_dashboard" sequence="1"/>
    <menuitem id="menu_deadline" name="Termíny ČNB" parent="investra_entity.menu_reports" action="action_deadline" sequence="10"/>
</odoo>
