<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="investra_dashboard.FundSummary">
        <div t-if="this.state.cards.length" class="o_investra_summary">
            <span class="o_investra_summary_total">Fondů: <t t-out="this.state.total"/></span>
            <button t-foreach="this.state.cards" t-as="card" t-key="card.key" type="button"
                    class="o_investra_summary_card" t-att-class="'o_investra_summary_' + card.key + (card.count ? '' : ' o_investra_summary_zero')"
                    t-on-click="() => this.toggle(card)">
                <span class="o_investra_summary_count" t-out="card.count"/>
                <span class="o_investra_summary_label" t-out="card.label"/>
            </button>
        </div>
    </t>

    <t t-name="investra_dashboard.FundDashboardRenderer" t-inherit="web.KanbanRenderer" t-inherit-mode="primary">
        <xpath expr="//div[@t-ref='this.rootRef']" position="before">
            <InvestraFundSummary/>
        </xpath>
    </t>
</templates>
