<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FX deriváty v ocenění (DE-04): spočtená a ruční reálná hodnota, rozdíl a uložené vstupy výpočtu. -->
    <record id="view_valuation_form_derivatives" model="ir.ui.view">
        <field name="name">investra.valuation.form.derivatives</field>
        <field name="model">investra.valuation</field>
        <field name="inherit_id" ref="investra_nav.view_valuation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='fees']" position="before">
                <page string="FX deriváty" name="derivatives" invisible="not derivative_line_ids">
                    <field name="derivative_line_ids">
                        <list>
                            <field name="derivative_id"/>
                            <field name="kind" optional="show"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="nominal" optional="hide"/>
                            <field name="computed_value"/>
                            <field name="has_manual" column_invisible="1"/>
                            <field name="manual_value" invisible="not has_manual"/>
                            <field name="manual_source" optional="show"/>
                            <field name="difference" invisible="not has_manual"/>
                            <field name="used_value"/>
                            <field name="booked_before"/>
                            <field name="change"/>
                            <field name="problem" optional="show" decoration-danger="problem"/>
                            <field name="inputs" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_fund_form_derivatives" model="ir.ui.view">
        <field name="name">investra.fund.form.derivatives</field>
        <field name="model">investra.fund</field>
        <field name="inherit_id" ref="investra_fund.view_fund_form"/>
        <field name="arch" type="xml">
            <field name="accrual_method" position="before">
                <field name="derivative_tolerance_pct"/>
            </field>
        </field>
    </record>
</odoo>
