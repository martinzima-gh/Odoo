<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scheme_form" model="ir.ui.view">
        <field name="name">investra.allocation.scheme.form</field>
        <field name="model">investra.allocation.scheme</field>
        <field name="arch" type="xml">
            <form><sheet><group>
                <field name="fund_id"/><field name="valid_from"/><field name="method"/>
                <field name="statute_ref"/><field name="residual_pro_rata"/>
            </group>
            <field name="line_ids"><list editable="bottom">
                <field name="class_id"/><field name="rank"/><field name="target_rate"/>
                <field name="residual_share"/><field name="loss_rank"/>
            </list></field></sheet></form>
        </field>
    </record>
    <record id="action_scheme" model="ir.actions.act_window">
        <field name="name">Alokační schémata</field><field name="res_model">investra.allocation.scheme</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_scheme" name="Alokační schémata" parent="investra_entity.menu_setup" action="action_scheme"/>
</odoo>
