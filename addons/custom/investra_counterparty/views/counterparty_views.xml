<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esa_sector_list" model="ir.ui.view">
        <field name="name">investra.esa.sector.list</field><field name="model">investra.esa.sector</field>
        <field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="id" optional="hide"/></list></field>
    </record>
    <record id="view_esa_sector_search" model="ir.ui.view">
        <field name="name">investra.esa.sector.search</field><field name="model">investra.esa.sector</field>
        <field name="arch" type="xml"><search><field name="code"/><field name="name"/></search></field>
    </record>
    <record id="view_profile_list" model="ir.ui.view">
        <field name="name">investra.counterparty.profile.list</field><field name="model">investra.counterparty.profile</field>
        <field name="arch" type="xml">
            <list><field name="partner_id"/><field name="country_id"/><field name="sector_id"/><field name="lei"/><field name="id" optional="hide"/></list>
        </field>
    </record>
    <record id="view_profile_search" model="ir.ui.view">
        <field name="name">investra.counterparty.profile.search</field><field name="model">investra.counterparty.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="lei"/>
                <field name="country_id"/>
                <field name="sector_id"/>
                <group>
                    <filter name="group_by_country" string="Země" context="{'group_by': 'country_id'}"/>
                    <filter name="group_by_sector" string="Sektor ESA 2010" context="{'group_by': 'sector_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_profile_form" model="ir.ui.view">
        <field name="name">investra.counterparty.profile.form</field><field name="model">investra.counterparty.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet><group><field name="partner_id"/><field name="country_id"/><field name="sector_id"/><field name="lei"/></group></sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_profile" model="ir.actions.act_window">
        <field name="name">Protistrany</field><field name="res_model">investra.counterparty.profile</field><field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_profile_search"/>
    </record>
    <record id="view_instrument_form_issuer" model="ir.ui.view">
        <field name="name">investra.instrument.form.issuer</field><field name="model">investra.instrument</field>
        <field name="inherit_id" ref="investra_instruments.view_instrument_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='isin']/.." position="after">
                <div class="o_investra_metadata_item">
                    <label for="issuer_id"/>
                    <field name="issuer_id" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>
    <record id="view_entity_form_counterparty" model="ir.ui.view">
        <field name="name">investra.entity.form.counterparty</field>
        <field name="model">investra.entity</field>
        <field name="inherit_id" ref="investra_entity.view_entity_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_currency']" position="after">
                <group string="Identifikace" name="group_identification">
                    <field name="company_registry" groups="base.group_erp_manager"/>
                    <field name="company_registry" readonly="1" groups="!base.group_erp_manager"/>
                    <field name="vat" groups="base.group_erp_manager"/>
                    <field name="vat" readonly="1" groups="!base.group_erp_manager"/>
                    <field name="lei"/>
                    <field name="esa_sector_id"/>
                    <button name="action_open_counterparty_profiles" type="object" string="Údaje protistrany"
                            class="btn-secondary" colspan="2"/>
                    <div class="text-muted" colspan="2">LEI a sektor se berou z údajů protistrany kontaktu společnosti
                        (jeden záznam, změny jsou v historii záznamu). U podfondu je LEI nepovinné.</div>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_entity_list_counterparty" model="ir.ui.view">
        <field name="name">investra.entity.list.counterparty</field>
        <field name="model">investra.entity</field>
        <field name="inherit_id" ref="investra_entity.view_entity_list"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after"><field name="lei" optional="hide"/></field>
        </field>
    </record>
    <menuitem id="menu_profile" name="Protistrany" parent="investra_entity.menu_setup_instruments" action="action_profile" sequence="30"/>
</odoo>
