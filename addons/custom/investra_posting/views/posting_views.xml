<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_list" model="ir.ui.view">
        <field name="name">investra.accounting.event.list</field>
        <field name="model">investra.accounting.event</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="date"/><field name="name"/><field name="event_type"/>
                <field name="fund_id" optional="show"/><field name="source_name" optional="show"/>
                <field name="amount" sum="Celkem" optional="show"/><field name="currency_id" optional="hide"/>
                <field name="amount_currency" optional="show"/><field name="foreign_currency_id" optional="show"/>
                <field name="state"/><field name="move_id"/><field name="reversal_move_id" optional="show"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_event_form" model="ir.ui.view">
        <field name="name">investra.accounting.event.form</field>
        <field name="model">investra.accounting.event</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,locked,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_source" type="object" class="oe_stat_button" icon="fa-external-link"
                                invisible="not res_id" string="Zdroj"/>
                        <button name="action_open_move" type="object" class="oe_stat_button" icon="fa-book"
                                invisible="not move_id" string="Doklad"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="fund_id"/>
                            <field name="company_id" string="Kniha"/>
                            <field name="date"/>
                            <field name="event_type"/>
                            <field name="source_name"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="currency_id"/>
                            <field name="amount_currency" invisible="not foreign_currency_id"/>
                            <field name="foreign_currency_id" invisible="not foreign_currency_id"/>
                            <field name="move_id"/>
                            <field name="reversal_move_id" invisible="not reversal_move_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Řádky dokladu" name="lines">
                            <field name="move_line_ids">
                                <list>
                                    <field name="account_id"/>
                                    <field name="name"/>
                                    <field name="investra_class_id" optional="show"/>
                                    <field name="investra_movement_type" optional="show"/>
                                    <field name="company_currency_id" column_invisible="1"/>
                                    <field name="debit" sum="MD"/>
                                    <field name="credit" sum="D"/>
                                    <field name="amount_currency" optional="show"/>
                                    <field name="currency_id" string="Měna" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Technické" name="technical">
                            <group>
                                <field name="key"/>
                                <field name="fingerprint"/>
                                <field name="res_model"/>
                                <field name="res_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_event_search" model="ir.ui.view">
        <field name="name">investra.accounting.event.search</field>
        <field name="model">investra.accounting.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="event_type"/>
                <field name="fund_id"/>
                <field name="key"/>
                <field name="date"/>
                <filter name="filter_draft" string="Návrh" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_locked" string="Zamčený návrh" domain="[('state', '=', 'locked')]"/>
                <filter name="filter_posted" string="Zaúčtováno" domain="[('state', '=', 'posted')]"/>
                <filter name="filter_reversed" string="Stornováno" domain="[('state', '=', 'reversed')]"/>
                <filter name="filter_discarded" string="Zrušený návrh" domain="[('state', '=', 'discarded')]"/>
                <separator/>
                <filter name="filter_date" date="date" string="Datum"/>
                <group>
                    <filter name="group_by_company" string="Kniha" context="{'group_by': 'company_id'}"/>
                    <filter name="group_by_fund" string="Fond" context="{'group_by': 'fund_id'}"/>
                    <filter name="group_by_event_type" string="Typ" context="{'group_by': 'event_type'}"/>
                    <filter name="group_by_state" string="Stav" context="{'group_by': 'state'}"/>
                    <filter name="group_by_date_month" string="Měsíc" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_event" model="ir.actions.act_window">
        <field name="name">Účetní události</field>
        <field name="res_model">investra.accounting.event</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_event_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Zatím tu není žádná účetní událost</p>
            <p>Původ každého dokladu, který vytvořily moduly Investra. Události vznikají automaticky a nejdou měnit; oprava se dělá ve zdrojovém záznamu stornem a novou verzí.</p>
        </field>
    </record>
    <menuitem id="menu_event" name="Účetní události" parent="investra_entity.menu_setup_audit" action="action_event" sequence="10"/>
    <record id="view_move_line_investra" model="ir.ui.view">
        <field name="name">account.move.investra</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="investra_event_id" invisible="not investra_event_id"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='name']" position="after">
                <field name="investra_class_id" optional="show"/>
                <field name="investra_movement_type" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
