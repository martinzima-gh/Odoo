<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cnb_map_list" model="ir.ui.view">
        <field name="name">investra.cnb.map.list</field><field name="model">investra.cnb.map</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="methodology"/><field name="sheet"/><field name="row"/><field name="column"/><field name="source"/><field name="role_id"/>
                <field name="ifrs9_category"/><field name="period"/><field name="sign"/><field name="report_sign"/><field name="rollup_rows"/><field name="valid_from"/><field name="valid_to"/>
            </list>
        </field>
    </record>
    <record id="action_cnb_map" model="ir.actions.act_window">
        <field name="name">Převodová tabulka ČNB</field><field name="res_model">investra.cnb.map</field><field name="view_mode">list</field>
    </record>
    <menuitem id="menu_cnb_map" name="Převodová tabulka ČNB" parent="investra_entity.menu_setup_cnb" action="action_cnb_map" sequence="10"/>
</odoo>
