<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fx_profile_list" model="ir.ui.view">
        <field name="name">investra.fx.profile.list</field><field name="model">investra.fx.profile</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="gain_account_id"/><field name="loss_account_id"/><field name="journal_id"/><field name="company_id" groups="base.group_multi_company"/></list>
        </field>
    </record>
    <record id="view_fx_profile_form" model="ir.ui.view">
        <field name="name">investra.fx.profile.form</field><field name="model">investra.fx.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="journal_id"/>
                        <field name="gain_account_id"/><field name="loss_account_id"/><field name="rate_source"/><field name="max_rate_age_days"/><field name="active"/>
                    </group>
                    <notebook><page string="Přeceňované účty"><field name="account_ids"/></page></notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_fx_profile" model="ir.actions.act_window">
        <field name="name">Profily přecenění</field><field name="res_model">investra.fx.profile</field><field name="view_mode">list,form</field>
    </record>
    <record id="view_fx_run_list" model="ir.ui.view">
        <field name="name">investra.fx.run.list</field><field name="model">investra.fx.run</field>
        <field name="arch" type="xml">
            <list><field name="date"/><field name="profile_id"/><field name="currency_id" column_invisible="1"/><field name="difference"/><field name="move_id"/><field name="move_state"/></list>
        </field>
    </record>
    <record id="view_fx_run_form" model="ir.ui.view">
        <field name="name">investra.fx.run.form</field><field name="model">investra.fx.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute" type="object" string="Spočítat" class="btn-primary" invisible="move_state == 'posted'"/>
                    <button name="action_create_move" type="object" string="Vytvořit návrh dokladu" invisible="not line_ids or move_state == 'posted'"/>
                </header>
                <sheet>
                    <group>
                        <field name="profile_id" readonly="move_state == 'posted'"/><field name="date" readonly="move_state == 'posted'"/>
                        <field name="company_id" groups="base.group_multi_company"/><field name="currency_id" invisible="1"/>
                        <field name="difference"/><field name="move_id"/><field name="move_state"/>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="account_id"/><field name="partner_id"/><field name="foreign_currency_id"/><field name="company_currency_id" column_invisible="1"/>
                            <field name="amount_currency"/><field name="rate"/><field name="balance"/><field name="target"/><field name="difference"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_fx_run" model="ir.actions.act_window">
        <field name="name">Přecenění cizích měn</field><field name="res_model">investra.fx.run</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_fx_profile" name="Profily přecenění" parent="account.account_account_menu" action="action_fx_profile" sequence="60"/>
    <menuitem id="menu_fx_run" name="Přecenění cizích měn" parent="account.menu_finance_entries" action="action_fx_run" sequence="60" groups="account.group_account_manager"/>
</odoo>
