<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fund_list" model="ir.ui.view">
        <field name="name">investra.fund.list</field>
        <field name="model">investra.fund</field>
        <field name="arch" type="xml">
            <list default_order="name asc"><field name="name"/><field name="currency_id"/><field name="valuation_frequency"/><field name="id" optional="hide"/></list>
        </field>
    </record>
    <record id="view_fund_search" model="ir.ui.view">
        <field name="name">investra.fund.search</field>
        <field name="model">investra.fund</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="entity_id"/>
                <group>
                    <filter name="group_by_valuation_frequency" string="Frekvence ocenění" context="{'group_by': 'valuation_frequency'}"/>
                    <filter name="group_by_trade_recognition" string="Zaúčtování obchodů" context="{'group_by': 'trade_recognition'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_fund_form" model="ir.ui.view">
        <field name="name">investra.fund.form</field>
        <field name="model">investra.fund</field>
        <field name="arch" type="xml">
            <form class="o_investra_fund_form">
                <sheet>
                    <div class="o_investra_fund_metadata">
                        <div class="o_investra_fund_metadata_item">
                            <label for="entity_id"/>
                            <field name="entity_id" nolabel="1" domain="[('entity_type', 'in', ['fund', 'subfund', 'sicav'])]"/>
                        </div>
                        <div class="o_investra_fund_metadata_item">
                            <label for="currency_id"/>
                            <field name="currency_id" nolabel="1"/>
                        </div>
                        <div class="o_investra_fund_metadata_item">
                            <label for="manager_id"/>
                            <field name="manager_id" nolabel="1"/>
                        </div>
                    </div>
                    <group string="Základní parametry">
                        <field name="valuation_frequency"/>
                        <field name="price_digits"/>
                        <field name="price_rounding"/>
                        <field name="trade_recognition"/>
                    </group>
                    <group string="Úpisy a odkupy – výchozí hodnoty tříd">
                        <field name="unit_digits"/><field name="unit_rounding"/><field name="rounding_owner"/>
                    </group>
                    <group string="Úročení nástrojů">
                        <field name="accrual_method"/>
                        <field name="accrual_note" invisible="accrual_method != 'linear'" required="accrual_method == 'linear'"/>
                    </group>
                    <notebook>
                        <page string="Třídy">
                            <field name="class_ids" context="{'default_price_digits': price_digits, 'default_price_rounding': price_rounding, 'default_unit_digits': unit_digits, 'default_unit_rounding': unit_rounding, 'default_rounding_owner': rounding_owner}">
                                <!-- Poplatky jen na třídě (ZJ-03); článek statutu, poznámku a historii změn ukáže formulář třídy. -->
                                <list editable="bottom" open_form_view="True">
                                    <field name="sequence" widget="handle"/>
                                    <field name="active" optional="hide"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="currency_id"/>
                                    <field name="price_digits"/>
                                    <field name="isin"/>
                                    <field name="distribution"/>
                                    <field name="unit_digits"/>
                                    <field name="price_rounding" optional="hide"/>
                                    <field name="unit_rounding" optional="hide"/>
                                    <field name="rounding_owner" optional="hide"/>
                                    <field name="entry_fee_rate" optional="show"/>
                                    <field name="entry_fee_recipient" optional="hide"/>
                                    <field name="exit_fee_rate" optional="show"/>
                                    <field name="exit_fee_recipient" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_fund_class_form" model="ir.ui.view">
        <field name="name">investra.fund.class.form</field>
        <field name="model">investra.fund.class</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivováno" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group string="Třída">
                            <field name="fund_id" readonly="id"/>
                            <field name="code"/><field name="name"/><field name="currency_id"/><field name="isin"/>
                            <field name="distribution"/><field name="sequence"/>
                        </group>
                        <group string="Kurz a kusy">
                            <field name="price_digits"/><field name="price_rounding"/>
                            <field name="unit_digits"/><field name="unit_rounding"/><field name="rounding_owner"/>
                        </group>
                    </group>
                    <group>
                        <group string="Vstupní poplatek">
                            <field name="entry_fee_rate" string="Sazba (%)"/>
                            <field name="entry_fee_recipient" string="Příjemce"/>
                            <field name="entry_fee_statute_ref" string="Článek statutu"/>
                            <field name="entry_fee_note" string="Poznámka"/>
                        </group>
                        <group string="Výstupní poplatek">
                            <field name="exit_fee_rate" string="Sazba (%)"/>
                            <field name="exit_fee_recipient" string="Příjemce"/>
                            <field name="exit_fee_statute_ref" string="Článek statutu"/>
                            <field name="exit_fee_note" string="Poznámka"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_fund" model="ir.actions.act_window">
        <field name="name">Fondy</field>
        <field name="res_model">investra.fund</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fund_search"/>
    </record>
    <menuitem id="menu_fund" name="Fondy" parent="investra_entity.menu_setup_funds" action="action_fund" sequence="10"/>
</odoo>
