<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Výchozí schvalovací matice = chování před maticí (rozhodnutí 2026-11-11). Změna = nový řádek s pozdějším „Platí od“. -->
    <record id="matrix_default_valuation_approve" model="investra.approval.matrix">
        <field name="activity">valuation_approve</field>
        <field name="valid_from">2000-01-01</field>
        <field name="performer_role">preparer</field>
        <field name="second_person">yes</field>
        <field name="step_ids" eval="[(0, 0, {'name': 'Kontrola druhou osobou', 'role': 'approver'})]"/>
        <field name="note">Výchozí – chování před maticí</field>
        <field name="builtin" eval="True"/>
    </record>
