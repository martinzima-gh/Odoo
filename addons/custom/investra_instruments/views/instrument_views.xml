<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_instrument_list" model="ir.ui.view">
        <field name="name">investra.instrument.list</field><field name="model">investra.instrument</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/><field name="isin"/><field name="type_id"/><field name="currency_id"/>
                <field name="cnb_sheet"/><field name="deviates_from_type"/>
            </list>
        </field>
    </record>
    <record id="view_instrument_search" model="ir.ui.view">
        <field name="name">investra.instrument.search</field>
        <field name="model">investra.instrument</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="isin"/>
                <field name="type_id"/>
                <field name="currency_id"/>
                <field name="fund_id"/>
                <group>
                    <filter name="group_by_type" string="Typ" context="{'group_by': 'type_id'}"/>
                    <filter name="group_by_currency" string="Měna" context="{'group_by': 'currency_id'}"/>
                    <filter name="group_by_fund" string="Fond" context="{'group_by': 'fund_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_instrument_form" model="ir.ui.view">
        <field name="name">investra.instrument.form</field><field name="model">investra.instrument</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Nástroj">
                            <field name="name"/><field name="type_id"/><field name="type_group"/>
                            <field name="isin"/><field name="currency_id"/>
                            <field name="market" invisible="type_group != 'listed'"/>
                            <field name="counterparty_id" invisible="type_group not in ('money_market', 'loan', 'derivative')"/>
                            <field name="collateral" invisible="type_group != 'money_market'"/>
                        </group>
                        <group string="Návrh z typu, účetní může změnit">
                            <field name="cnb_sheet"/>
                            <field name="max_price_age"/>
                            <field name="fair_value_level"/><field name="deviates_from_type"/>
                        </group>
                    </group>
                    <group string="Ostatní podíl" invisible="type_group != 'other_holding'">
                        <field name="fund_id" required="type_group == 'other_holding'"/><field name="class_id"/>
                        <field name="holding_kind" required="type_group == 'other_holding'"/>
                        <field name="commitment_amount"/><field name="order_ref"/>
                    </group>
                    <group string="Úročení" invisible="type_group not in ('debt', 'money_market', 'loan')">
                        <field name="maturity_date"/><field name="coupon_rate"/><field name="day_count"/><field name="price_excludes_accrued"/>
                        <field name="accrual_method"/>
                        <field name="accrual_note" invisible="accrual_method != 'linear'" required="accrual_method == 'linear'"/>
                    </group>
                    <notebook>
                        <page string="Zařazení ve fondech">
                            <field name="classification_ids" readonly="1">
                                <list>
                                    <field name="fund_id"/><field name="portfolio_id"/><field name="business_model"/>
                                    <field name="valid_from"/><field name="ifrs9_category"/><field name="valuation_method"/><field name="role_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Smluvní peněžní toky" invisible="type_group not in ('debt', 'money_market', 'loan')">
                            <field name="cashflow_ids">
                                <list editable="bottom"><field name="date"/><field name="flow_type"/><field name="amount"/></list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_trade_list" model="ir.ui.view">
        <field name="name">investra.trade.list</field><field name="model">investra.trade</field>
        <field name="arch" type="xml">
            <list>
                <field name="fund_id"/><field name="portfolio_id" optional="show"/><field name="instrument_id"/>
                <field name="ifrs9_category" optional="show"/><field name="trade_date"/><field name="settlement_date"/>
                <field name="side"/><field name="units"/><field name="price"/><field name="accrued_interest" optional="hide"/><field name="fx_rate"/><field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_trade_search" model="ir.ui.view">
        <field name="name">investra.trade.search</field>
        <field name="model">investra.trade</field>
        <field name="arch" type="xml">
            <search>
                <field name="fund_id"/>
                <field name="instrument_id"/>
                <field name="trade_date"/>
                <filter name="filter_draft" string="Návrh" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_unsettled" string="Sjednáno, nevypořádáno" domain="[('state', '=', 'unsettled')]"/>
                <filter name="filter_settled" string="Vypořádáno" domain="[('state', '=', 'settled')]"/>
                <separator/>
                <filter name="filter_trade_date" date="trade_date" string="Datum obchodu"/>
                <group>
                    <filter name="group_by_fund" string="Fond" context="{'group_by': 'fund_id'}"/>
                    <filter name="group_by_portfolio" string="Obchodní model" context="{'group_by': 'portfolio_id'}"/>
                    <filter name="group_by_instrument" string="Nástroj" context="{'group_by': 'instrument_id'}"/>
                    <filter name="group_by_state" string="Stav" context="{'group_by': 'state'}"/>
                    <filter name="group_by_trade_date_month" string="Měsíc obchodu" context="{'group_by': 'trade_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_trade_form" model="ir.ui.view">
        <field name="name">investra.trade.form</field><field name="model">investra.trade</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_book" type="object" string="Zaúčtovat" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_settle" type="object" string="Vypořádat" class="btn-primary" invisible="state != 'unsettled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="fund_id" readonly="event_id or state == 'settled'"/>
                            <field name="portfolio_id" readonly="event_id or state == 'settled'" options="{'no_create': True}"/>
                            <field name="side" widget="radio" options="{'horizontal': true}" readonly="event_id or state == 'settled'"/>
                            <field name="held_instrument_ids" invisible="1"/>
                            <field name="instrument_id" readonly="event_id or state == 'settled'"
                                   domain="side == 'sell' and [('id', 'in', held_instrument_ids)] or []"/>
                            <field name="classification_id"/>
                            <field name="ifrs9_category"/>
                            <field name="held_quantity" invisible="side != 'sell' or state != 'draft'"/>
                            <field name="units" readonly="event_id or state == 'settled'"/>
                            <field name="quantity" invisible="1" force_save="1"/>
                            <field name="price" readonly="event_id or state == 'settled'"/>
                            <field name="instrument_kind" invisible="1"/>
                            <field name="accrued_interest" invisible="instrument_kind != 'bond'" readonly="event_id or state == 'settled'"/>
                        </group>
                        <group>
                            <field name="trade_date" readonly="event_id or state == 'settled'"/>
                            <field name="settlement_date" readonly="state == 'settled'"/>
                            <field name="fx_rate" readonly="event_id or state == 'settled'"/>
                            <field name="settlement_fx_rate" readonly="state == 'settled'"/>
                            <field name="event_id"/><field name="settlement_event_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_instrument_type_list" model="ir.ui.view">
        <field name="name">investra.instrument.type.list</field><field name="model">investra.instrument.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/><field name="name"/><field name="group"/><field name="kind"/>
                <field name="ifrs9_category" string="Kategorie (typická)"/><field name="valuation_method"/><field name="role_id"/>
                <field name="cnb_sheet"/><field name="max_price_age"/>
            </list>
        </field>
    </record>
    <record id="action_instrument_type" model="ir.actions.act_window">
        <field name="name">Typy nástrojů</field><field name="res_model">investra.instrument.type</field><field name="view_mode">list</field>
    </record>
    <record id="action_instrument" model="ir.actions.act_window">
        <field name="name">Nástroje</field><field name="res_model">investra.instrument</field><field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_instrument_search"/>
    </record>
    <record id="view_price_list" model="ir.ui.view">
        <field name="name">investra.instrument.price.list</field>
        <field name="model">investra.instrument.price</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_approve" type="object" string="Schválit"/>
                </header>
                <field name="date" string="Datum"/>
                <field name="instrument_id" string="Nástroj"/>
                <field name="scope" optional="show"/>
                <field name="fund_id" string="Fond"/>
                <field name="price" string="Cena"/>
                <field name="currency_id"/>
                <field name="source"/>
                <field name="deviation_reason" optional="show"/>
                <field name="state" string="Stav" widget="badge" decoration-warning="state == 'draft'" decoration-success="state == 'approved'"/>
                <field name="entered_by" string="Zadal" optional="show"/>
                <field name="approved_by" string="Schválil" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_price_form" model="ir.ui.view">
        <field name="name">investra.instrument.price.form</field>
        <field name="model">investra.instrument.price</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Schválit" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="instrument_id" string="Nástroj" readonly="state == 'approved'"/>
                            <field name="fund_id" string="Fond" readonly="state == 'approved' or id"
                                   placeholder="Prázdné = sdílená tržní cena pro všechny fondy"/>
                            <field name="scope"/>
                            <field name="date" string="Datum" readonly="state == 'approved'"/>
                        </group>
                        <group>
                            <field name="price" string="Cena"/>
                            <field name="currency_id" options="{'no_create': True}"/>
                            <field name="source"/>
                            <field name="deviation_reason" invisible="not fund_id"/>
                            <field name="entered_by" string="Zadal"/>
                            <field name="approved_by" string="Schválil"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_price_search" model="ir.ui.view">
        <field name="name">investra.instrument.price.search</field>
        <field name="model">investra.instrument.price</field>
        <field name="arch" type="xml">
            <search>
                <field name="instrument_id"/>
                <field name="fund_id"/>
                <field name="date"/>
                <field name="source"/>
                <filter name="filter_draft" string="Ke schválení" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_approved" string="Schválené" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter name="filter_shared" string="Sdílené" domain="[('fund_id', '=', False)]"/>
                <filter name="filter_fund" string="Ceny fondu" domain="[('fund_id', '!=', False)]"/>
                <separator/>
                <filter name="filter_date" date="date" string="Datum ceny"/>
                <group>
                    <filter name="group_by_fund" string="Fond" context="{'group_by': 'fund_id'}"/>
                    <filter name="group_by_instrument" string="Nástroj" context="{'group_by': 'instrument_id'}"/>
                    <filter name="group_by_state" string="Stav" context="{'group_by': 'state'}"/>
                    <filter name="group_by_date_month" string="Měsíc" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_price" model="ir.actions.act_window">
        <field name="name">Ceny</field><field name="res_model">investra.instrument.price</field><field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_price_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Zatím tu není žádná cena</p>
            <p>Cena nástroje k datu v měně nástroje za kus. Bez fondu je to sdílená tržní cena pro všechny fondy, s fondem cena jen
               pro tento fond (posudek, odchylka). Ocenění bere poslední známou schválenou cenu; schválit ji musí jiný uživatel,
               než který ji zadal. Oprava schválené ceny ji vrátí ke schválení.</p>
        </field>
    </record>
    <record id="action_trade" model="ir.actions.act_window">
        <field name="name">Obchody</field><field name="res_model">investra.trade</field><field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_trade_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Zatím tu není žádný obchod</p>
            <p>Nákupy a prodeje nástrojů fondu. Pozice ve fondu se počítají z obchodů, ručně se nezadávají.</p>
        </field>
    </record>
    <menuitem id="menu_instruments" name="Portfolio" parent="investra_entity.menu_root" sequence="20"/>
    <menuitem id="menu_instrument" name="Nástroje" parent="investra_entity.menu_setup_instruments" action="action_instrument" sequence="10"/>
    <menuitem id="menu_instrument_type" name="Typy nástrojů" parent="investra_entity.menu_setup_instruments" action="action_instrument_type" sequence="20"/>
    <menuitem id="menu_price" name="Ceny" parent="menu_instruments" action="action_price" sequence="20"/>
    <menuitem id="menu_trade" name="Obchody" parent="menu_instruments" action="action_trade" sequence="10"/>

    <record id="view_classification_list" model="ir.ui.view">
        <field name="name">investra.portfolio.classification.list</field><field name="model">investra.portfolio.classification</field>
        <field name="arch" type="xml">
            <list>
                <field name="fund_id"/><field name="portfolio_id"/><field name="business_model" optional="show"/>
                <field name="instrument_id"/><field name="instrument_nature" optional="show"/><field name="valid_from"/>
                <field name="valid_to" optional="hide"/><field name="sppi" optional="show"/>
                <field name="mandatory_category" optional="show"/><field name="designation" optional="show"/>
                <field name="category_override" optional="show"/>
                <field name="ifrs9_category"/><field name="valuation_method"/><field name="role_id" optional="show"/>
                <field name="deviates_from_proposal" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_classification_override_wizard_form" model="ir.ui.view">
        <field name="name">investra.classification.override.wizard.form</field>
        <field name="model">investra.classification.override.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p>Ruční kategorie je odchylka od rozhodovacího stromu IFRS 9 a ukáže se v ocenění. Vyžaduje-li schvalovací
                   matice druhou osobu, vznikne žádost a kategorie se zapíše až po potvrzení.</p>
                <group>
                    <field name="classification_id" readonly="1"/>
                    <field name="category_override"/>
                    <field name="override_note"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Potvrdit" class="btn-primary"/>
                    <button special="cancel" string="Zrušit"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_classification_override_wizard" model="ir.actions.act_window">
        <field name="name">Ruční kategorie IFRS 9</field>
        <field name="res_model">investra.classification.override.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="view_classification_form" model="ir.ui.view">
        <field name="name">investra.portfolio.classification.form</field><field name="model">investra.portfolio.classification</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(action_classification_override_wizard)d" type="action" string="Ruční kategorie…"
                            context="{'default_classification_id': id}" invisible="not id"/>
                </header>
                <sheet>
                    <group>
                        <group string="Pozice">
                            <field name="portfolio_id" options="{'no_create': True}"/><field name="fund_id"/>
                            <field name="instrument_id"/><field name="instrument_kind"/>
                            <field name="valid_from"/><field name="valid_to"/>
                        </group>
                        <group string="(a) Povaha nástroje">
                            <field name="instrument_nature"/>
                            <field name="nature_note" placeholder="Posouzení podle IAS 32, je-li povaha jiná než podle druhu"/>
                        </group>
                    </group>
                    <group>
                        <group string="(b) Test SPPI" invisible="instrument_nature not in ('debt', 'puttable')">
                            <field name="sppi"/>
                            <field name="sppi_version" invisible="sppi == 'na'" required="sppi != 'na'"/>
                            <field name="sppi_note" invisible="sppi == 'na'" required="sppi != 'na'"/>
                        </group>
                        <group string="(c) Obchodní model">
                            <field name="business_model"/>
                        </group>
                    </group>
                    <group>
                        <group string="(d) Povinná klasifikace">
                            <field name="mandatory_category"/>
                        </group>
                        <group string="(e) Určení / volba" invisible="instrument_nature not in ('debt', 'puttable', 'equity')">
                            <field name="designation"/>
                            <field name="designation_note" invisible="designation == 'none'" required="designation != 'none'"/>
                        </group>
                    </group>
                    <group string="(f) Výsledek">
                        <group>
                            <field name="computed_category"/>
                            <field name="category_override"/>
                            <field name="override_note" invisible="not category_override" required="category_override"/>
                            <field name="ifrs9_category"/>
                            <field name="valuation_method" readonly="ifrs9_category == 'amortised'"/>
                            <field name="role_id"/><field name="deviates_from_proposal"/><field name="note"/>
                        </group>
                        <group>
                            <field name="classification_basis" nolabel="1" colspan="2"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_classification_search" model="ir.ui.view">
        <field name="name">investra.portfolio.classification.search</field><field name="model">investra.portfolio.classification</field>
        <field name="arch" type="xml">
            <search>
                <field name="instrument_id"/><field name="fund_id"/><field name="portfolio_id"/>
                <group>
                    <filter name="group_by_fund" string="Fond" context="{'group_by': 'fund_id'}"/>
                    <filter name="group_by_portfolio" string="Obchodní model" context="{'group_by': 'portfolio_id'}"/>
                    <filter name="group_by_category" string="Kategorie IFRS 9" context="{'group_by': 'ifrs9_category'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_portfolio_list" model="ir.ui.view">
        <field name="name">investra.fund.portfolio.list</field><field name="model">investra.fund.portfolio</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/><field name="fund_id"/><field name="name"/><field name="business_model"/>
            </list>
        </field>
    </record>
    <record id="view_portfolio_form" model="ir.ui.view">
        <field name="name">investra.fund.portfolio.form</field><field name="model">investra.fund.portfolio</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="fund_id" options="{'no_create': True}"/><field name="name"/><field name="business_model"/>
                        <field name="assessment"/><field name="active" invisible="1"/>
                    </group>
                    <field name="classification_ids" context="{'default_portfolio_id': id}">
                        <list>
                            <field name="instrument_id"/><field name="instrument_nature"/><field name="valid_from"/><field name="sppi"/>
                            <field name="mandatory_category"/><field name="designation"/>
                            <field name="ifrs9_category"/><field name="valuation_method"/><field name="role_id"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_fund_form_portfolio" model="ir.ui.view">
        <field name="name">investra.fund.form.portfolio</field><field name="model">investra.fund</field>
        <field name="inherit_id" ref="investra_fund.view_fund_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Obchodní modely">
                    <field name="portfolio_ids">
                        <list><field name="sequence" widget="handle"/><field name="name"/><field name="business_model"/></list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="action_portfolio" model="ir.actions.act_window">
        <field name="name">Obchodní modely</field><field name="res_model">investra.fund.portfolio</field><field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Zatím tu není žádný obchodní model</p>
            <p>Portfolio fondu s obchodním modelem podle IFRS 9. Nový fond dostane portfolio „Hlavní“ s modelem Řízení na reálnou hodnotu; model je potřeba posoudit a doložit.</p>
        </field>
    </record>
    <record id="action_classification" model="ir.actions.act_window">
        <field name="name">Zařazení nástrojů</field><field name="res_model">investra.portfolio.classification</field>
        <field name="view_mode">list,form</field><field name="search_view_id" ref="view_classification_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Zatím tu není žádné zařazení</p>
            <p>Kategorie IFRS 9, způsob ocenění a role účtu nástroje v obchodním modelu fondu s platností od.
               Obchod bez zařazení nejde zaúčtovat; po prvním obchodu zařazení změní jen reklasifikace.</p>
        </field>
    </record>
    <menuitem id="menu_portfolio" name="Obchodní modely" parent="menu_instruments" action="action_portfolio" sequence="30"/>
    <menuitem id="menu_classification" name="Zařazení nástrojů" parent="menu_instruments" action="action_classification" sequence="40"/>
</odoo>
