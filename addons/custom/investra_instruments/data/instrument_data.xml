<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Kód nástroje = prefix typu + číslo z této řady (rozhodnutí 2026-11-13 „Sdílené nástroje a pravidlo knihy“). -->
    <record id="seq_instrument" model="ir.sequence">
        <field name="name">Kód nástroje</field>
        <field name="code">investra.instrument</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <!-- Změny smluvních toků v historii nástroje; kontrola ocenění instrument_changes je čte. -->
    <record id="mt_instrument_change" model="mail.message.subtype">
        <field name="name">Změna nástroje</field>
        <field name="res_model">investra.instrument</field>
        <field name="internal" eval="True"/>
        <field name="default" eval="False"/>
    </record>
</odoo>
