<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rate_list" model="ir.ui.view">
        <field name="name">investra.rate.list</field>
        <field name="model">investra.rate</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="date"/><field name="source"/><field name="currency_id"/>
                <field name="quantity"/><field name="rate"/><field name="fetched_at"/>
            </list>
        </field>
    </record>
    <record id="view_rate_search" model="ir.ui.view">
        <field name="name">investra.rate.search</field>
        <field name="model">investra.rate</field>
        <field name="arch" type="xml">
            <search>
                <field name="currency_id"/>
                <field name="date"/>
                <filter name="filter_cnb" string="ČNB" domain="[('source', '=', 'cnb')]"/>
                <filter name="filter_ecb" string="ECB" domain="[('source', '=', 'ecb')]"/>
                <separator/>
                <filter name="filter_date" date="date" string="Datum kurzu"/>
                <group>
                    <filter name="group_by_currency" string="Měna" context="{'group_by': 'currency_id'}"/>
                    <filter name="group_by_source" string="Zdroj" context="{'group_by': 'source'}"/>
                    <filter name="group_by_date_month" string="Měsíc" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_rate" model="ir.actions.act_window">
        <field name="name">Vyhlášené kurzy</field>
        <field name="res_model">investra.rate</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_rate_search"/>
    </record>
    <menuitem id="menu_rate" name="Kurzy měn" parent="investra_entity.menu_valuation_section" action="action_rate" sequence="20"/>
</odoo>
