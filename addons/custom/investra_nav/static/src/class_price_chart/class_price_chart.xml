<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="investra_nav.ClassPriceChartPanel">
        <div class="o_investra_class_price_chart_canvas" t-attf-style="height: {{ this.props.height }}px;">
            <canvas t-ref="this.chart.ref"/>
        </div>
    </t>

    <t t-name="investra_nav.ClassPriceChart">
        <div class="o_investra_class_price_chart">
            <div class="o_investra_class_price_chart_header">
                <div>
                    <h2>Vývoj kurzů tříd</h2>
                    <p>Zveřejněné kurzy podle měny třídy do data tohoto ocenění.</p>
                </div>
                <div t-if="this.state.status === 'ready'" class="o_investra_class_price_chart_periods" role="group" aria-label="Období grafu">
                    <t t-foreach="this.periods" t-as="period" t-key="period.key">
                        <button type="button" t-att-class="this.state.period === period.key ? 'btn btn-sm active' : 'btn btn-sm'"
                                t-att-aria-pressed="this.state.period === period.key ? 'true' : 'false'"
                                t-on-click="() => this.setPeriod(period.key)" t-out="period.label"/>
                    </t>
                </div>
            </div>
            <p t-if="this.state.status === 'loading'">Načítám zveřejněné kurzy…</p>
            <p t-elif="this.state.status === 'unsaved'">Uložte ocenění.</p>
            <p t-elif="this.state.status === 'empty'">Zatím žádné zveřejněné ocenění.</p>
            <p t-elif="this.state.status === 'error'">Graf nelze zobrazit. Ocenění tím není dotčené.</p>
            <t t-elif="this.hasVisibleData">
                <t t-foreach="this.panels" t-as="panel" t-key="panel.key">
                    <InvestraPriceChartPanel height="panel.height" getConfig="() => this.getChartConfig(panel)"/>
                </t>
                <p class="o_investra_class_price_chart_note" t-out="this.note"/>
            </t>
            <p t-else="">V tomto období nejsou zveřejněné kurzy.</p>
        </div>
    </t>
</templates>
