<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Návrhy splátek podle kalendáře, denně; nic se neúčtuje (rozhodnutí 2026-11-12 „Návrhy kalendářních splátek“). -->
    <record id="cron_scheduled_repayment_drafts" model="ir.cron">
        <field name="name">Investra: návrhy splátek podle kalendáře</field>
        <field name="model_id" ref="model_investra_instrument_repayment"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_scheduled_drafts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
