<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_valuation_list" model="ir.ui.view">
        <field name="name">investra.valuation.list</field>
        <field name="model">investra.valuation</field>
        <field name="arch" type="xml">
            <list>
                <field name="fund_id"/>
                <field name="date"/>
                <field name="version"/>
                <field name="previous_id" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="fund_capital"/>
            </list>
        </field>
    </record>
    <record id="view_valuation_search" model="ir.ui.view">
        <field name="name">investra.valuation.search</field>
        <field name="model">investra.valuation</field>
        <field name="arch" type="xml">
            <search>
                <field name="fund_id"/>
                <field name="date"/>
                <filter name="filter_in_progress" string="Rozpracovaná" domain="[('state', 'in', ('draft', 'computed', 'returned'))]"/>
                <filter name="filter_submitted" string="Ke schválení" domain="[('state', '=', 'submitted')]"/>
                <separator/>
                <filter name="filter_approved_posted" string="Schválená a zaúčtovaná" domain="[('state', 'in', ('approved', 'posted'))]"/>
                <filter name="filter_depositary" string="U depozitáře" domain="[('state', 'in', ('sent', 'confirmed'))]"/>
                <filter name="filter_published" string="Zveřejněná" domain="[('state', '=', 'published')]"/>
                <filter name="filter_reversed" string="Stornovaná" domain="[('state', '=', 'reversed')]"/>
                <separator/>
                <filter name="filter_date" date="date" string="Datum ocenění"/>
                <group>
                    <filter name="group_by_fund" string="Fond" context="{'group_by': 'fund_id'}"/>
                    <filter name="group_by_state" string="Stav" context="{'group_by': 'state'}"/>
                    <filter name="group_by_date_month" string="Měsíc ocenění" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_valuation_form" model="ir.ui.view">
        <field name="name">investra.valuation.form</field>
        <field name="model">investra.valuation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute" type="object" string="Spočítat" invisible="state not in ('draft', 'computed')" class="btn-primary"/>
                    <button name="action_submit" type="object" string="Odeslat ke schválení" invisible="state != 'computed'"/>
                    <button name="action_approve" type="object" string="Schválit" invisible="state != 'submitted'"/>
                    <button name="action_post" type="object" string="Zaúčtovat" invisible="state != 'approved'"/>
                    <button name="action_send_depositary" type="object" string="Odeslat depozitáři" invisible="state != 'posted'"/>
                    <button name="action_depositary_confirm" type="object" string="Potvrzeno depozitářem" invisible="state != 'sent'"/>
                    <button name="action_publish" type="object" string="Zveřejnit a uzamknout" invisible="state != 'confirmed'"/>
                    <button name="action_build_package" type="object" string="Balíček pro depozitáře" invisible="state not in ('posted', 'sent', 'confirmed', 'published')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,computed,submitted,approved,posted,sent,confirmed,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="fund_id" readonly="state != 'draft'"/>
                            <span> – </span>
                            <field name="date" readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Ocenění">
                            <field name="version"/>
                            <field name="previous_id"/>
                            <field name="preparer_id" string="Zadal"/>
                        </group>
                        <group string="Výsledek">
                            <field name="fund_capital"/>
                            <field name="neutral_capital"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="package_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Třídy"><field name="class_line_ids"><list>
                            <field name="class_id"/>
                            <field name="pre_capital" optional="show"/>
                            <field name="ratio" optional="hide"/>
                            <field name="delta" optional="show"/>
                            <field name="capital"/>
                            <field name="units"/>
                            <field name="price"/>
                        </list></field></page>
                        <page string="Portfolio"><field name="portfolio_line_ids"><list>
                            <field name="kind"/>
                            <field name="name"/>
                            <field name="isin" optional="show"/>
                            <field name="currency_id" optional="show"/>
                            <field name="quantity"/>
                            <field name="price"/>
                            <field name="cost" optional="hide"/>
                            <field name="fair_value_currency" optional="hide"/>
                            <field name="fx_rate" optional="show"/>
                            <field name="fair_value"/>
                        </list></field></page>
                        <page string="Úplaty"><field name="fee_line_ids"><list><field name="rule_id"/><field name="class_id"/><field name="amount"/></list></field></page>
                        <page string="Ručně doložené úplaty" invisible="not external_fee_ids and state in ('submitted', 'approved', 'posted', 'sent', 'confirmed', 'published')">
                            <div class="alert alert-warning" role="alert">Výjimka: úplata spočtená mimo Odoo. Každý řádek potřebuje důvod a přílohu s výpočtem. Částka vstoupí do ocenění jako úplata a zaúčtuje se s oceněním po schválení.</div>
                            <field name="external_fee_ids"><list editable="bottom">
                            <field name="rule_id"/><field name="class_id"/><field name="amount"/><field name="reason"/><field name="attachment_id"/>
                        </list></field></page>
                        <page string="Kontroly"><field name="check_ids"><list><field name="name"/><field name="status"/><field name="detail"/></list></field></page>
                        <page string="Schválení"><field name="approval_ids"><list><field name="name"/><field name="user_id"/><field name="approved_at"/></list></field></page>
                        <page string="Doklady"><field name="event_ids"><list><field name="name"/><field name="state"/><field name="move_id"/></list></field></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_valuation" model="ir.actions.act_window">
        <field name="name">Ocenění</field>
        <field name="res_model">investra.valuation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_valuation_search"/>
    </record>
    <record id="view_fee_rule_form" model="ir.ui.view">
        <field name="name">investra.fee.rule.form</field>
        <field name="model">investra.fee.rule</field>
        <field name="arch" type="xml">
            <form><sheet>
                <group>
                    <group><field name="fund_id"/><field name="name"/><field name="kind"/><field name="sequence"/><field name="statute_ref"/></group>
                    <group><field name="basis"/><field name="base_source"/><field name="base_mode"/><field name="expense_role"/><field name="crystallisation"/></group>
                </group>
                <group>
                    <field name="class_ids" widget="many2many_tags"/>
                    <field name="recipient_share"/><field name="recipient_class_ids" widget="many2many_tags"/><field name="cover_class_id"/>
                </group>
                <field name="version_ids"><list editable="bottom">
                    <field name="valid_from"/><field name="decision_ref"/><field name="rate"/><field name="threshold"/><field name="fixed_monthly"/>
                    <field name="min_annual"/><field name="max_annual"/><field name="hurdle_kind"/><field name="hurdle_rate"/>
                </list></field>
            </sheet></form>
        </field>
    </record>
    <record id="view_fee_rule_search" model="ir.ui.view">
        <field name="name">investra.fee.rule.search</field>
        <field name="model">investra.fee.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="fund_id"/>
                <field name="statute_ref"/>
                <filter name="filter_periodic" string="Časově rozlišená úplata" domain="[('kind', '=', 'periodic')]"/>
                <filter name="filter_performance" string="Výkonnostní odměna" domain="[('kind', '=', 'performance')]"/>
                <filter name="filter_tax" string="Očekávaná daň" domain="[('kind', '=', 'tax')]"/>
                <filter name="filter_external" string="Ručně doložená úplata" domain="[('kind', '=', 'external')]"/>
                <separator/>
                <filter name="filter_archived" string="Archivováno" domain="[('active', '=', False)]" context="{'active_test': False}"/>
                <group>
                    <filter name="group_by_fund" string="Fond" context="{'group_by': 'fund_id'}"/>
                    <filter name="group_by_kind" string="Druh" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_fee_rule" model="ir.actions.act_window">
        <field name="name">Pravidla úplat</field><field name="res_model">investra.fee.rule</field><field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fee_rule_search"/>
    </record>
    <record id="view_movement_list" model="ir.ui.view">
        <field name="name">investra.class.movement.list</field>
        <field name="model">investra.class.movement</field>
        <field name="arch" type="xml">
            <list>
                <field name="date" string="Datum"/>
                <field name="fund_id" string="Fond"/>
                <field name="class_id" string="Třída"/>
                <field name="movement_type" string="Typ"/>
                <field name="units" string="Kusy"/>
                <field name="currency_id" string="Měna kurzu" optional="show"/>
                <field name="amount_class" string="Částka v měně kurzu" optional="show"/>
                <field name="fx_rate" string="Kurz" optional="show"/>
                <field name="amount" string="Částka ve funkční měně"/>
                <field name="event_id" string="Účetní událost" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_movement_search" model="ir.ui.view">
        <field name="name">investra.class.movement.search</field>
        <field name="model">investra.class.movement</field>
        <field name="arch" type="xml">
            <search>
                <field name="class_id"/>
                <field name="fund_id"/>
                <field name="date"/>
                <filter name="filter_subscription" string="Úpisy" domain="[('movement_type', '=', 'subscription')]"/>
                <filter name="filter_redemption" string="Odkupy" domain="[('movement_type', '=', 'redemption')]"/>
                <separator/>
                <filter name="filter_unposted" string="Nezaúčtováno" domain="[('event_id', '=', False)]"/>
                <filter name="filter_posted" string="Zaúčtováno" domain="[('event_id', '!=', False)]"/>
                <separator/>
                <filter name="filter_date" date="date" string="Datum"/>
                <group>
                    <filter name="group_by_fund" string="Fond" context="{'group_by': 'fund_id'}"/>
                    <filter name="group_by_class" string="Třída" context="{'group_by': 'class_id'}"/>
                    <filter name="group_by_type" string="Typ" context="{'group_by': 'movement_type'}"/>
                    <filter name="group_by_date_month" string="Měsíc" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_movement" model="ir.actions.act_window">
        <field name="name">Úpisy a odkupy</field><field name="res_model">investra.class.movement</field><field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_movement_search"/>
    </record>
    <record id="view_instrument_form_schedule" model="ir.ui.view">
        <field name="name">investra.instrument.form.schedule</field><field name="model">investra.instrument</field>
        <field name="inherit_id" ref="investra_instruments.view_instrument_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='maturity_date']" position="before"><field name="principal"/><field name="start_date"/></xpath>
            <xpath expr="//sheet" position="before">
                <header><button name="action_generate_schedule" type="object" string="Vygenerovat kalendář" invisible="type_group != 'money_market'"/></header>
            </xpath>
        </field>
    </record>
    <record id="view_repayment_list" model="ir.ui.view">
        <field name="name">investra.instrument.repayment.list</field><field name="model">investra.instrument.repayment</field>
        <field name="arch" type="xml">
            <list><field name="date"/><field name="fund_id"/><field name="instrument_id"/><field name="amount"/><field name="event_id"/></list>
        </field>
    </record>
    <record id="view_repayment_search" model="ir.ui.view">
        <field name="name">investra.instrument.repayment.search</field>
        <field name="model">investra.instrument.repayment</field>
        <field name="arch" type="xml">
            <search>
                <field name="fund_id"/>
                <field name="instrument_id"/>
                <field name="date"/>
                <filter name="filter_unposted" string="Nezaúčtováno" domain="[('event_id', '=', False)]"/>
                <filter name="filter_posted" string="Zaúčtováno" domain="[('event_id', '!=', False)]"/>
                <separator/>
                <filter name="filter_date" date="date" string="Datum"/>
                <group>
                    <filter name="group_by_fund" string="Fond" context="{'group_by': 'fund_id'}"/>
                    <filter name="group_by_instrument" string="Nástroj" context="{'group_by': 'instrument_id'}"/>
                    <filter name="group_by_date_month" string="Měsíc" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_repayment_form" model="ir.ui.view">
        <field name="name">investra.instrument.repayment.form</field><field name="model">investra.instrument.repayment</field>
        <field name="arch" type="xml">
            <form>
                <header><button name="action_book" type="object" string="Zaúčtovat" class="btn-primary" invisible="event_id"/></header>
                <sheet><group><field name="fund_id"/><field name="instrument_id"/><field name="date"/><field name="amount"/><field name="fx_rate"/><field name="event_id"/></group></sheet>
            </form>
        </field>
    </record>
    <record id="action_repayment" model="ir.actions.act_window">
        <field name="name">Splátky nástrojů</field><field name="res_model">investra.instrument.repayment</field><field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_repayment_search"/>
    </record>
    <menuitem id="menu_repayment" name="Splátky nástrojů" parent="investra_instruments.menu_instruments" action="action_repayment" sequence="30"/>
    <menuitem id="menu_valuation" name="Ocenění" parent="investra_entity.menu_valuation_section" action="action_valuation" sequence="10"/>
    <menuitem id="menu_movement" name="Úpisy a odkupy" parent="investra_entity.menu_root" action="action_movement" sequence="30"/>
    <menuitem id="menu_fee_rule" name="Pravidla úplat" parent="investra_entity.menu_setup_funds" action="action_fee_rule" sequence="30"/>
</odoo>
