<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_valuation_list" model="ir.ui.view">
        <field name="name">investra.valuation.list</field>
        <field name="model">investra.valuation</field>
        <field name="arch" type="xml">
            <!-- Řazení přebírá _order modelu (fund_id, date desc, version desc); výchozí seskupení podle fondu
                 je v kontextu action_valuation, proto je sloupec Fond volitelný a skrytý (rozhodnutí 2026-11-14). -->
            <list>
                <field name="date"/>
                <field name="state" widget="badge"/>
                <field name="fund_id" optional="hide"/>
                <field name="version"/>
                <field name="previous_id" optional="hide"/>
                <field name="fund_capital"/>
            </list>
        </field>
    </record>
    <record id="view_valuation_search" model="ir.ui.view">
        <field name="name">investra.valuation.search</field>
        <field name="model">investra.valuation</field>
        <field name="arch" type="xml">
            <search>
                <field name="fund_id"/>
                <field name="date"/>
                <filter name="filter_in_progress" string="Rozpracovaná" domain="[('state', 'in', ('draft', 'computed', 'returned'))]"/>
                <filter name="filter_submitted" string="Ke schválení" domain="[('state', '=', 'submitted')]"/>
                <separator/>
                <filter name="filter_approved_posted" string="Schválená a zaúčtovaná" domain="[('state', 'in', ('approved', 'posted'))]"/>
                <filter name="filter_depositary" string="U depozitáře" domain="[('state', 'in', ('sent', 'confirmed'))]"/>
                <filter name="filter_published" string="Zveřejněná" domain="[('state', '=', 'published')]"/>
                <filter name="filter_reversed" string="Stornovaná" domain="[('state', '=', 'reversed')]"/>
                <separator/>
                <filter name="filter_date" date="date" string="Datum ocenění"/>
                <group>
                    <filter name="group_by_fund" string="Fond" context="{'group_by': 'fund_id'}"/>
                    <filter name="group_by_state" string="Stav" context="{'group_by': 'state'}"/>
                    <filter name="group_by_date_month" string="Měsíc ocenění" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_valuation_return_wizard_form" model="ir.ui.view">
        <field name="name">investra.valuation.return.wizard.form</field>
        <field name="model">investra.valuation.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Vrácení ocenění">
                <group>
                    <field name="valuation_id" readonly="1"/>
                    <field name="mode" readonly="1"/>
                </group>
                <div class="alert alert-warning" role="alert"><field name="effect" readonly="1"/></div>
                <group>
                    <field name="reason" placeholder="Proč se ocenění vrací (uloží se k ocenění)"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Potvrdit" class="btn-primary"/>
                    <button special="cancel" string="Zrušit"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_valuation_return_wizard" model="ir.actions.act_window">
        <field name="name">Vrácení ocenění</field>
        <field name="res_model">investra.valuation.return.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="view_valuation_class_form" model="ir.ui.view">
        <field name="name">investra.valuation.class.form</field>
        <field name="model">investra.valuation.class</field>
        <field name="arch" type="xml">
            <form string="Přemostění třídy">
                <sheet>
                    <div class="oe_title"><h2><field name="class_id" readonly="1"/></h2></div>
                    <div class="text-muted mb-3">FK (t−1) + úpisy − odkupy − dividendy + změna společná + změna specifická = FK.</div>
                    <group>
                        <group string="Počáteční stav">
                            <field name="opening_capital"/>
                            <field name="opening_units"/>
                            <field name="opening_price"/>
                        </group>
                        <group string="Pohyby">
                            <field name="subscription_amount"/>
                            <field name="subscription_units"/>
                            <field name="redemption_amount"/>
                            <field name="redemption_units"/>
                            <field name="dividend_amount"/>
                            <field name="pre_capital" string="Upravený FK"/>
                        </group>
                        <group string="Rozdělení výsledku">
                            <field name="ratio" string="Alokační poměr" widget="percentage" options="{'digits': [16, 6]}"/>
                            <field name="shared_result"/>
                            <field name="rounding_amount"/>
                            <field name="delta" string="Změna specifická"/>
                            <field name="fee_amount"/>
                            <field name="performance_amount"/>
                            <field name="allocation_amount"/>
                            <field name="other_amount"/>
                        </group>
                        <group string="Konečný stav">
                            <field name="capital" string="FK"/>
                            <field name="units" string="Kusy"/>
                            <field name="price" string="Kurz"/>
                            <field name="price_change_pct" decoration-success="price_change_pct &gt; 0" decoration-danger="price_change_pct &lt; 0"/>
                        </group>
                        <group string="V měně třídy" invisible="not foreign_currency">
                            <field name="currency_name"/>
                            <field name="fx_rate"/>
                            <field name="opening_capital_class"/>
                            <field name="subscription_amount_class"/>
                            <field name="redemption_amount_class"/>
                            <field name="capital_class"/>
                        </group>
                        <field name="foreign_currency" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_valuation_form" model="ir.ui.view">
        <field name="name">investra.valuation.form</field>
        <field name="model">investra.valuation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute" type="object" string="Spočítat" invisible="state not in ('draft', 'computed')" class="btn-primary"/>
                    <button name="action_submit" type="object" string="Odeslat ke schválení" invisible="state != 'computed'"/>
                    <button name="action_approve" type="object" string="Schválit" invisible="state != 'submitted'"/>
                    <button name="action_post" type="object" string="Zaúčtovat" invisible="state != 'approved'"/>
                    <button name="action_send_depositary" type="object" string="Odeslat depozitáři" invisible="state != 'posted'"/>
                    <button name="action_depositary_confirm" type="object" string="Potvrzeno depozitářem" invisible="state != 'sent'"/>
                    <button name="action_publish" type="object" string="Zveřejnit a uzamknout" invisible="state != 'confirmed'"/>
                    <button name="action_build_package" type="object" string="Balíček pro depozitáře" invisible="state not in ('posted', 'sent', 'confirmed', 'published')"/>
                    <button name="%(action_valuation_return_wizard)d" type="action" string="Vrátit k přepracování"
                            context="{'default_valuation_id': id, 'default_mode': 'return'}"
                            groups="investra_entity.group_valuation_approver" invisible="state not in ('submitted', 'approved')"/>
                    <button name="%(action_valuation_return_wizard)d" type="action" string="Vrátit depozitářem"
                            context="{'default_valuation_id': id, 'default_mode': 'depositary'}"
                            groups="investra_entity.group_valuation_approver" invisible="state != 'sent'"/>
                    <button name="%(action_valuation_return_wizard)d" type="action" string="Stornovat a přepracovat"
                            context="{'default_valuation_id': id, 'default_mode': 'reverse'}"
                            groups="investra_entity.group_valuation_approver" invisible="state not in ('posted', 'confirmed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,computed,submitted,approved,posted,sent,confirmed,published"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="state not in ('returned', 'reversed')">
                        <strong>Ocenění je vrácené, platí jeho další verze.</strong> Důvod: <field name="return_reason" readonly="1"/>
                    </div>
                    <field name="package_ok" invisible="1"/>
                    <div class="alert alert-danger" role="alert" invisible="package_ok">
                        <strong>Balíček pro depozitáře neodpovídá souboru, který systém sestavil.</strong> Sestavte balíček znovu a zjistěte, kdo přílohu změnil.
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="fund_id" readonly="state != 'draft'"/>
                            <span> – </span>
                            <field name="date" readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Ocenění">
                            <field name="version"/>
                            <field name="previous_id"/>
                            <field name="preparer_id" string="Zadal" help="Uživatel, který ocenění založil."/>
                        </group>
                        <group string="Výsledek">
                            <field name="fund_capital"/>
                            <field name="neutral_capital"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="package_name" invisible="1"/>
                            <field name="package_file" filename="package_name" readonly="1" invisible="not package_id"/>
                            <field name="package_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Třídy"><field name="class_line_ids"><list>
                            <field name="class_id" string="Třída"/>
                            <field name="currency_name" optional="show"/>
                            <field name="units" string="Kusy"/>
                            <field name="opening_capital" sum="Celkem"/>
                            <field name="subscription_units" optional="hide"/>
                            <field name="subscription_amount" sum="Celkem"/>
                            <field name="redemption_units" optional="hide"/>
                            <field name="redemption_amount" sum="Celkem"/>
                            <field name="dividend_amount" optional="hide" sum="Celkem"/>
                            <field name="pre_capital" string="Upravený FK" optional="hide" sum="Celkem"/>
                            <field name="ratio" string="Alokační poměr" widget="percentage" options="{'digits': [16, 6]}" sum="Celkem"/>
                            <field name="shared_result" sum="Celkem"/>
                            <field name="delta" string="Změna specifická" sum="Celkem"/>
                            <field name="capital" string="FK" sum="Celkem"/>
                            <field name="capital_class" optional="show"/>
                            <field name="price" string="Kurz"/>
                            <field name="price_change_pct" optional="show" decoration-success="price_change_pct &gt; 0" decoration-danger="price_change_pct &lt; 0"/>
                            <field name="opening_price" optional="hide"/>
                            <field name="fx_rate" optional="hide"/>
                        </list></field></page>
                        <page string="Portfolio"><field name="portfolio_line_ids"><list>
                            <field name="kind"/>
                            <field name="name"/>
                            <field name="portfolio_id" optional="hide"/>
                            <field name="ifrs9_category" optional="show"/>
                            <field name="isin" optional="show"/>
                            <field name="currency_id" optional="show"/>
                            <field name="quantity"/>
                            <field name="price"/>
                            <field name="cost" optional="hide"/>
                            <field name="accrued_interest_currency" optional="show"/>
                            <field name="fair_value_currency" optional="hide"/>
                            <field name="fx_rate" optional="show"/>
                            <field name="fair_value"/>
                            <field name="realised" optional="show"/>
                        </list></field></page>
                        <page string="Úplaty"><field name="fee_line_ids"><list><field name="rule_id"/><field name="class_id"/><field name="amount"/></list></field></page>
                        <page string="Ručně doložené úplaty" invisible="not external_fee_ids and state in ('submitted', 'approved', 'posted', 'sent', 'confirmed', 'published')">
                            <div class="alert alert-warning" role="alert">Výjimka: úplata spočtená mimo Odoo. Každý řádek potřebuje důvod a přílohu s výpočtem. Částka vstoupí do ocenění jako úplata a zaúčtuje se s oceněním po schválení.</div>
                            <field name="external_fee_ids"><list editable="bottom">
                            <!-- Pravidlo a třída jen z fondu ocenění; nové pravidlo z výběru má fond a druh předvyplněné a zamčené
                                 (uživatel 2026-11-13). -->
                            <field name="rule_id" domain="[('kind', '=', 'external'), ('fund_id', '=', parent.fund_id)]"
                                   context="{'default_fund_id': parent.fund_id, 'default_kind': 'external', 'investra_lock_fund': True}"/>
                            <field name="class_id" domain="[('fund_id', '=', parent.fund_id)]" context="{'default_fund_id': parent.fund_id}"/>
                            <field name="amount"/><field name="reason"/>
                            <field name="document_name" column_invisible="1"/>
                            <field name="document" filename="document_name"/>
                        </list></field></page>
                        <page string="Kontroly"><field name="check_ids"><list><field name="name"/><field name="status"/><field name="detail"/></list></field></page>
                        <page string="Schválení"><field name="approval_ids"><list><field name="name"/><field name="min_role"/><field name="alone" optional="show"/><field name="user_id"/><field name="approved_at"/><field name="matrix_id" optional="hide"/></list></field></page>
                        <page string="Doklady"><field name="event_ids"><list><field name="name"/><field name="state"/><field name="move_id"/></list></field></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Vzhled detailu ocenění podle návrhu docs/vzhled/navrh-detail-oceneni.html (uživatel 2026-11-13; navazuje na
         CP-2026-11-13): širší list, nadpis fondu s údaji ocenění, pás FK / změna FK / výsledek za období a karta každé
         třídy se změnou kurzu a malým grafem za 12 měsíců (widget investra_valuation_summary). Jen rozložení a zobrazení;
         pole, výpočty a akce beze změny. NFK je na stránce Kontroly. -->
    <record id="view_valuation_form_class_price_chart" model="ir.ui.view">
        <field name="name">investra.valuation.form.summary</field>
        <field name="model">investra.valuation</field>
        <field name="inherit_id" ref="view_valuation_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form" position="attributes">
                <attribute name="class" add="o_investra_valuation_form" separator=" "/>
            </xpath>
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="replace">
                <div class="oe_title">
                    <h1><field name="fund_id" readonly="state != 'draft'"/></h1>
                    <div invisible="state != 'draft'" class="o_investra_valuation_date">
                        <label for="date" string="Ocenění k"/>
                        <field name="date"/>
                    </div>
                </div>
                <widget name="investra_valuation_summary"/>
            </xpath>
            <xpath expr="//sheet/group" position="replace">
                <!-- Údaje pro souhrn nahoře; zobrazuje je widget. -->
                <group invisible="1">
                    <field name="version"/>
                    <field name="previous_id"/>
                    <field name="preparer_id"/>
                    <field name="fund_capital"/>
                    <field name="currency_id"/>
                    <field name="package_name"/>
                    <field name="package_id"/>
                </group>
                <div class="o_investra_valuation_package" invisible="not package_id">
                    <span>Balíček pro depozitáře</span>
                    <field name="package_file" filename="package_name" readonly="1"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='class_line_ids']/list/field[@name='class_id']" position="replace">
                <field name="class_id" column_invisible="1"/>
                <field name="class_code" width="70px"/>
            </xpath>
            <xpath expr="//field[@name='class_line_ids']/list/field[@name='currency_name']" position="attributes">
                <attribute name="width">70px</attribute>
            </xpath>
            <xpath expr="//field[@name='class_line_ids']/list/field[@name='units']" position="attributes">
                <attribute name="options">{'hide_trailing_zeros': true}</attribute>
            </xpath>
            <xpath expr="//field[@name='class_line_ids']/list/field[@name='price']" position="replace">
                <field name="price_display" string="Kurz" class="text-end"/>
            </xpath>
            <xpath expr="//field[@name='class_line_ids']/list/field[@name='price_change_pct']" position="replace">
                <field name="price_change_pct" column_invisible="1"/>
                <field name="price_change_display" optional="show" class="text-end"
                       decoration-success="price_change_pct &gt; 0" decoration-danger="price_change_pct &lt; 0"/>
            </xpath>
            <xpath expr="//field[@name='check_ids']" position="before">
                <group>
                    <field name="neutral_capital" help="Neutrální fondový kapitál: FK fondu bez specifických změn tříd; dělí se mezi třídy alokačním poměrem."/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="action_valuation" model="ir.actions.act_window">
        <field name="name">Ocenění</field>
        <field name="res_model">investra.valuation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_valuation_search"/>
        <field name="context">{'search_default_group_by_fund': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Zatím tu není žádné ocenění</p>
            <p>Ocenění fondu k datu. Připravovatel založí ocenění, stiskne Spočítat a po kontrolách ho odešle ke schválení; zaúčtovat lze jen ocenění schválené druhou osobou.</p>
        </field>
    </record>
    <record id="view_fee_rule_form" model="ir.ui.view">
        <field name="name">investra.fee.rule.form</field>
        <field name="model">investra.fee.rule</field>
        <field name="arch" type="xml">
            <form><sheet>
                <group>
                    <group><field name="fund_id" readonly="context.get('investra_lock_fund')" force_save="1"/><field name="name"/><field name="kind" readonly="context.get('investra_lock_fund')" force_save="1"/><field name="sequence"/><field name="statute_ref"/></group>
                    <group><field name="basis"/><field name="base_source"/><field name="base_mode"/><field name="expense_role"/><field name="crystallisation"/></group>
                </group>
                <group>
                    <field name="class_ids" widget="many2many_tags"/>
                    <field name="recipient_share"/><field name="recipient_class_ids" widget="many2many_tags"/><field name="cover_class_id"/>
                </group>
                <field name="version_ids"><list editable="bottom">
                    <field name="valid_from"/><field name="decision_ref"/><field name="rate"/><field name="threshold"/><field name="fixed_monthly"/>
                    <field name="min_annual"/><field name="max_annual"/><field name="hurdle_kind"/><field name="hurdle_rate"/>
                </list></field>
            </sheet></form>
        </field>
    </record>
    <record id="view_fee_rule_search" model="ir.ui.view">
        <field name="name">investra.fee.rule.search</field>
        <field name="model">investra.fee.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="fund_id"/>
                <field name="statute_ref"/>
                <filter name="filter_periodic" string="Časově rozlišená úplata" domain="[('kind', '=', 'periodic')]"/>
                <filter name="filter_performance" string="Výkonnostní odměna" domain="[('kind', '=', 'performance')]"/>
                <filter name="filter_tax" string="Očekávaná daň" domain="[('kind', '=', 'tax')]"/>
                <filter name="filter_external" string="Ručně doložená úplata" domain="[('kind', '=', 'external')]"/>
                <separator/>
                <filter name="filter_archived" string="Archivováno" domain="[('active', '=', False)]" context="{'active_test': False}"/>
                <group>
                    <filter name="group_by_fund" string="Fond" context="{'group_by': 'fund_id'}"/>
                    <filter name="group_by_kind" string="Druh" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_fee_rule" model="ir.actions.act_window">
        <field name="name">Pravidla úplat</field><field name="res_model">investra.fee.rule</field><field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fee_rule_search"/>
    </record>
    <record id="action_movement_reverse_wizard" model="ir.actions.act_window">
        <field name="name">Storno nebo oprava pohybu</field>
        <field name="res_model">investra.class.movement.reverse.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="view_movement_list" model="ir.ui.view">
        <field name="name">investra.class.movement.list</field>
        <field name="model">investra.class.movement</field>
        <field name="arch" type="xml">
            <!-- Nejnovější nahoře, při shodném datu fondy abecedně (požadavek 2026-11-14). -->
            <list default_order="date desc, fund_id asc" decoration-muted="state == 'reversed'" decoration-info="state == 'draft'">
                <field name="date" string="Datum"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-muted="state == 'reversed'"/>
                <field name="fund_id" string="Fond"/>
                <field name="class_id" string="Třída"/>
                <field name="movement_type" string="Typ"/>
                <field name="source" optional="show"/>
                <field name="external_ref" optional="hide"/>
                <field name="units" string="Kusy"/>
                <field name="price" optional="show"/>
                <field name="currency_id" string="Měna kurzu" optional="show"/>
                <field name="amount_class" optional="show"/>
                <field name="fee_amount_class" optional="show"/>
                <field name="rounding_amount_class" optional="hide"/>
                <field name="fx_rate" string="Kurz" optional="show"/>
                <field name="amount"/>
                <field name="capital_amount_signed" optional="show"
                       decoration-success="movement_type == 'subscription'" decoration-danger="movement_type == 'redemption'"/>
                <field name="capital_amount" optional="hide"/>
                <field name="event_id" string="Účetní událost" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_movement_form" model="ir.ui.view">
        <field name="name">investra.class.movement.form</field>
        <field name="model">investra.class.movement</field>
        <field name="arch" type="xml">
            <form class="o_investra_movement_form">
                <header>
                    <button name="action_book" type="object" string="Zaúčtovat" class="btn-primary"
                            groups="investra_entity.group_valuation_preparer" invisible="state != 'draft' or not id"/>
                    <button name="%(action_movement_reverse_wizard)d" type="action" string="Opravit"
                            context="{'default_movement_id': id, 'default_mode': 'correct'}"
                            groups="investra_entity.group_valuation_preparer" invisible="state != 'posted'"/>
                    <button name="%(action_movement_reverse_wizard)d" type="action" string="Stornovat"
                            context="{'default_movement_id': id, 'default_mode': 'reverse'}"
                            groups="investra_entity.group_valuation_preparer" invisible="state != 'posted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="class_id" readonly="state != 'draft'"/></h1>
                    </div>
                    <div class="o_investra_metadata">
                        <div class="o_investra_metadata_item">
                            <label for="fund_id"/>
                            <field name="fund_id" nolabel="1"/>
                        </div>
                        <div class="o_investra_metadata_item">
                            <label for="movement_type"/>
                            <field name="movement_type" nolabel="1" readonly="state != 'draft'"/>
                        </div>
                        <div class="o_investra_metadata_item">
                            <label for="source"/>
                            <field name="source" nolabel="1" readonly="state != 'draft'"/>
                        </div>
                        <div class="o_investra_metadata_item">
                            <label for="currency_id"/>
                            <field name="currency_id" nolabel="1"/>
                        </div>
                    </div>
                    <div class="o_investra_metric_strip">
                        <div class="o_investra_metric_item">
                            <label for="units"/>
                            <field name="units" nolabel="1" readonly="state != 'draft'"/>
                        </div>
                        <div class="o_investra_metric_item">
                            <label for="price"/>
                            <field name="price" nolabel="1" readonly="state != 'draft'"/>
                        </div>
                        <div class="o_investra_metric_item">
                            <label for="amount_class"/>
                            <field name="amount_class" nolabel="1" readonly="state != 'draft'"/>
                        </div>
                    </div>
                    <group class="o_investra_movement_content">
                        <group string="Pohyb">
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="external_ref" readonly="state != 'draft'" required="source == 'is'"/>
                            <field name="manual_reason" readonly="state != 'draft'" required="source == 'manual'"
                                   invisible="source != 'manual'"/>
                            <field name="replaced_id" invisible="not replaced_id"/>
                            <field name="valuation_id" invisible="not valuation_id"/>
                            <field name="price_reason" readonly="state != 'draft'"/>
                        </group>
                        <group string="Cena a měna">
                            <field name="fx_rate" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                        </group>
                        <group string="Poplatek">
                            <field name="fee_amount_class" readonly="state != 'draft'"/>
                            <field name="fee_expected_class"/>
                            <field name="fee_recipient" readonly="state != 'draft'"/>
                            <field name="fee_partner_id" readonly="state != 'draft'"/>
                        </group>
                        <group string="Zaokrouhlení a výsledek">
                            <field name="rounding_amount_class" readonly="state != 'draft'"/>
                            <field name="rounding_owner" readonly="state != 'draft'"/>
                            <field name="value_class"/>
                            <field name="residual_class"/>
                            <field name="payout_class" invisible="movement_type != 'redemption'"/>
                            <field name="capital_amount"/>
                            <field name="capital_amount_class"/>
                        </group>
                        <group string="Účetní událost">
                            <field name="event_id"/>
                        </group>
                    </group>
                    <group invisible="state != 'reversed'">
                        <field name="reversal_reason"/>
                    </group>
                    <notebook invisible="not posting_preview">
                        <page name="posting_preview" string="Zaúčtování">
                            <field name="posting_preview" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_movement_reverse_wizard_form" model="ir.ui.view">
        <field name="name">investra.class.movement.reverse.wizard.form</field>
        <field name="model">investra.class.movement.reverse.wizard</field>
        <field name="arch" type="xml">
            <form string="Storno nebo oprava pohybu">
                <group>
                    <field name="movement_id" readonly="1"/>
                    <field name="mode" readonly="1"/>
                </group>
                <div class="alert alert-warning" role="alert"><field name="effect" readonly="1"/></div>
                <group>
                    <field name="reason" placeholder="Proč se pohyb stornuje nebo opravuje (uloží se k pohybu)"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Potvrdit" class="btn-primary"/>
                    <button special="cancel" string="Zrušit"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_movement_book" model="ir.actions.server">
        <field name="name">Zaúčtovat</field>
        <field name="model_id" ref="model_investra_class_movement"/>
        <field name="binding_model_id" ref="model_investra_class_movement"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('investra_entity.group_valuation_preparer'))]"/>
        <field name="state">code</field>
        <field name="code">result = records.action_book()
if isinstance(result, dict):
    action = result</field>
    </record>
    <record id="view_movement_search" model="ir.ui.view">
        <field name="name">investra.class.movement.search</field>
        <field name="model">investra.class.movement</field>
        <field name="arch" type="xml">
            <search>
                <field name="class_id"/>
                <field name="fund_id"/>
                <field name="date"/>
                <filter name="filter_subscription" string="Úpisy" domain="[('movement_type', '=', 'subscription')]"/>
                <filter name="filter_redemption" string="Odkupy" domain="[('movement_type', '=', 'redemption')]"/>
                <separator/>
                <filter name="filter_unposted" string="Nezaúčtováno" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_posted" string="Zaúčtováno" domain="[('state', '=', 'posted')]"/>
                <filter name="filter_reversed" string="Stornováno" domain="[('state', '=', 'reversed')]"/>
                <separator/>
                <filter name="filter_manual" string="Ruční zadání" domain="[('source', '=', 'manual')]"/>
                <filter name="filter_is" string="Z IS" domain="[('source', '=', 'is')]"/>
                <separator/>
                <filter name="filter_date" date="date" string="Datum"/>
                <group>
                    <filter name="group_by_fund" string="Fond" context="{'group_by': 'fund_id'}"/>
                    <filter name="group_by_class" string="Třída" context="{'group_by': 'class_id'}"/>
                    <filter name="group_by_type" string="Typ" context="{'group_by': 'movement_type'}"/>
                    <filter name="group_by_date_month" string="Měsíc" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_movement" model="ir.actions.act_window">
        <field name="name">Úpisy a odkupy</field><field name="res_model">investra.class.movement</field><field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_movement_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Zatím tu není žádný úpis ani odkup</p>
            <p>Pohyby kapitálu a kusů tříd fondu. Dokud nepřicházejí z IS, zadávají se ručně; zaúčtují se jako účetní událost a vstupují do dalšího ocenění.</p>
        </field>
    </record>
    <record id="view_instrument_form_schedule" model="ir.ui.view">
        <field name="name">investra.instrument.form.schedule</field><field name="model">investra.instrument</field>
        <field name="inherit_id" ref="investra_instruments.view_instrument_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='maturity_date']" position="before"><field name="principal"/><field name="start_date"/><field name="coupon_frequency"/></xpath>
            <xpath expr="//sheet" position="before">
                <header><button name="action_generate_schedule" type="object" string="Vygenerovat kalendář" invisible="type_group not in ('money_market', 'debt', 'loan')"/></header>
            </xpath>
        </field>
    </record>
    <record id="action_repayment_reverse_wizard" model="ir.actions.act_window">
        <field name="name">Storno nebo oprava splátky</field>
        <field name="res_model">investra.instrument.repayment.reverse.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="view_repayment_drafts_wizard_form" model="ir.ui.view">
        <field name="name">investra.instrument.repayment.drafts.wizard.form</field>
        <field name="model">investra.instrument.repayment.drafts.wizard</field>
        <field name="arch" type="xml">
            <form string="Návrhy podle kalendáře">
                <p class="text-muted">
                    Založí návrhy splátek pro toky kalendáře splatné do zvoleného data ve fondech vybraných společností.
                    Nic se neúčtuje; návrh zaúčtujete až po kontrole. Tok, který už návrh nebo splátku má, se přeskočí.
                </p>
                <group>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Založit návrhy" class="btn-primary"/>
                    <button string="Zrušit" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_repayment_list" model="ir.ui.view">
        <field name="name">investra.instrument.repayment.list</field><field name="model">investra.instrument.repayment</field>
        <field name="arch" type="xml">
            <list default_order="date asc" decoration-muted="state == 'reversed'">
                <header><button name="action_create_scheduled_drafts" type="object" string="Návrhy podle kalendáře" display="always" groups="investra_entity.group_valuation_preparer"/></header>
                <field name="date"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-muted="state == 'reversed'"/>
                <field name="fund_id"/><field name="portfolio_id" optional="show"/><field name="instrument_id"/>
                <field name="kind" optional="show"/><field name="closes_position" optional="show"/>
                <field name="principal_amount" optional="show"/><field name="interest_amount" optional="show"/>
                <field name="fee_amount" optional="hide"/><field name="amount"/><field name="event_id"/>
            </list>
        </field>
    </record>
    <record id="view_repayment_search" model="ir.ui.view">
        <field name="name">investra.instrument.repayment.search</field>
        <field name="model">investra.instrument.repayment</field>
        <field name="arch" type="xml">
            <search>
                <field name="fund_id"/>
                <field name="instrument_id"/>
                <field name="date"/>
                <filter name="filter_unposted" string="Nezaúčtováno" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_posted" string="Zaúčtováno" domain="[('state', '=', 'posted')]"/>
                <filter name="filter_reversed" string="Stornováno" domain="[('state', '=', 'reversed')]"/>
                <separator/>
                <filter name="filter_date" date="date" string="Datum"/>
                <group>
                    <filter name="group_by_fund" string="Fond" context="{'group_by': 'fund_id'}"/>
                    <filter name="group_by_instrument" string="Nástroj" context="{'group_by': 'instrument_id'}"/>
                    <filter name="group_by_date_month" string="Měsíc" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_repayment_form" model="ir.ui.view">
        <field name="name">investra.instrument.repayment.form</field><field name="model">investra.instrument.repayment</field>
        <field name="arch" type="xml">
            <form class="o_investra_repayment_form">
                <header>
                    <button name="action_book" type="object" string="Zaúčtovat" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="%(action_repayment_reverse_wizard)d" type="action" string="Opravit"
                            context="{'default_repayment_id': id, 'default_mode': 'correct'}"
                            groups="investra_entity.group_valuation_preparer" invisible="state != 'posted'"/>
                    <button name="%(action_repayment_reverse_wizard)d" type="action" string="Stornovat"
                            context="{'default_repayment_id': id, 'default_mode': 'reverse'}"
                            groups="investra_entity.group_valuation_preparer" invisible="state != 'posted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <field name="allowed_instrument_ids" invisible="1"/>
                    <field name="allowed_portfolio_ids" invisible="1"/>
                    <field name="portfolio_choice" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="not write_off_amount">
                        Pozice se uzavře, ale jistina <field name="write_off_amount" class="oe_inline" readonly="1"/> zůstane
                        neuhrazená: ocenění ji (s naběhlým úrokem) odúčtuje do výsledku. Jde-li o částečnou splátku, zrušte volbu
                        Uzavírá pozici.
                    </div>
                    <div class="oe_title">
                        <h1>Splátka nástroje – <field name="date" nolabel="1" readonly="state != 'draft'"/></h1>
                    </div>
                    <div class="o_investra_metadata">
                        <div class="o_investra_metadata_item">
                            <label for="fund_id"/>
                            <field name="fund_id" nolabel="1" readonly="state != 'draft'"/>
                        </div>
                        <div class="o_investra_metadata_item">
                            <label for="instrument_id"/>
                            <field name="instrument_id" nolabel="1" options="{'no_create': True}" readonly="state != 'draft'"/>
                        </div>
                        <div class="o_investra_metadata_item">
                            <label for="portfolio_id"/>
                            <field name="portfolio_id" nolabel="1" options="{'no_create': True}" readonly="state != 'draft' or not portfolio_choice" force_save="1"/>
                        </div>
                    </div>
                    <div class="o_investra_metric_strip">
                        <div class="o_investra_metric_item">
                            <label for="principal_amount"/>
                            <field name="principal_amount" nolabel="1" readonly="state != 'draft'"/>
                        </div>
                        <div class="o_investra_metric_item">
                            <label for="interest_amount"/>
                            <field name="interest_amount" nolabel="1" readonly="state != 'draft'"/>
                        </div>
                        <div class="o_investra_metric_item">
                            <label for="amount"/>
                            <field name="amount" nolabel="1"/>
                        </div>
                    </div>
                    <group>
                        <group string="Pozice">
                            <field name="remaining_before"/>
                            <field name="remaining_after"/>
                        </group>
                        <group string="Splátka">
                            <field name="kind" readonly="state != 'draft'"/>
                            <field name="closes_position" readonly="state != 'draft'" invisible="kind != 'extraordinary'"/>
                            <field name="fee_amount" readonly="state != 'draft'"/>
                            <field name="fx_rate" readonly="state != 'draft'"/>
                            <field name="replaced_id" invisible="not replaced_id"/>
                            <field name="event_id"/>
                            <field name="reversal_reason" invisible="state != 'reversed'"/>
                        </group>
                    </group>
                    <notebook invisible="not posting_preview">
                        <page name="posting_preview" string="Zaúčtování">
                            <field name="posting_preview" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_repayment_reverse_wizard_form" model="ir.ui.view">
        <field name="name">investra.instrument.repayment.reverse.wizard.form</field>
        <field name="model">investra.instrument.repayment.reverse.wizard</field>
        <field name="arch" type="xml">
            <form string="Storno nebo oprava splátky">
                <group>
                    <field name="repayment_id" readonly="1"/>
                    <field name="mode" readonly="1"/>
                </group>
                <div class="alert alert-warning" role="alert"><field name="effect" readonly="1"/></div>
                <group>
                    <field name="reason" placeholder="Proč se splátka stornuje nebo opravuje (uloží se ke splátce)"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Potvrdit" class="btn-primary"/>
                    <button special="cancel" string="Zrušit"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_repayment" model="ir.actions.act_window">
        <field name="name">Splátky nástrojů</field><field name="res_model">investra.instrument.repayment</field><field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_repayment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Zatím tu není žádná splátka</p>
            <p>Splátky jistiny a úroku držených nástrojů, například úvěru nebo termínovaného vkladu, v naběhlé i reálné hodnotě. Splátka účtuje na inkasa na cestě, která vynuluje bankovní výpis; jistina snižuje zbývající jistinu pozice a rozdíl proti očekávání doúčtuje ocenění.</p>
        </field>
    </record>
    <menuitem id="menu_repayment" name="Splátky nástrojů" parent="investra_instruments.menu_instruments" action="action_repayment" sequence="30"/>
    <menuitem id="menu_valuation" name="Ocenění" parent="investra_entity.menu_root" action="action_valuation" sequence="10"/>
    <menuitem id="menu_movement" name="Úpisy a odkupy" parent="investra_entity.menu_root" action="action_movement" sequence="30"/>
    <menuitem id="menu_fee_rule" name="Pravidla úplat" parent="investra_entity.menu_setup_funds" action="action_fee_rule" sequence="30"/>
</odoo>
