<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ZJ-25: rozpad třídy po účtech (dočasné záznamy), doklady převodů a položky deníku -->
    <record id="view_valuation_class_account_list" model="ir.ui.view">
        <field name="name">investra.valuation.class.account.list</field>
        <field name="model">investra.valuation.class.account</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="mode, sequence, id">
                <field name="sequence" column_invisible="1"/>
                <field name="mode" column_invisible="1"/>
                <field name="group"/>
                <field name="account_id" optional="show"/>
                <field name="name"/>
                <field name="common" sum="Společné – fond"/>
                <field name="share" sum="Podíl třídy"/>
                <field name="specific" sum="Specifické – třída"/>
                <field name="impact" sum="Vliv na FK třídy"/>
                <button name="action_open_lines" type="object" icon="fa-list" string="Položky deníku" invisible="not account_id"/>
                <button name="action_open_documents" type="object" icon="fa-file-text-o" string="Doklady" invisible="group != 'transfer'"/>
            </list>
        </field>
    </record>
    <record id="view_valuation_class_transfer_list" model="ir.ui.view">
        <field name="name">investra.valuation.class.transfer.list</field>
        <field name="model">investra.valuation.class.transfer</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="move_id"/>
                <field name="source_name"/>
                <field name="common" sum="Společné – fond"/>
                <field name="specific" sum="Specifické – třída"/>
                <button name="action_open_move" type="object" icon="fa-external-link" string="Otevřít doklad"/>
            </list>
        </field>
    </record>
    <record id="view_move_line_class_split_list" model="ir.ui.view">
        <field name="name">account.move.line.class.split.list</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="date, id">
                <field name="date"/>
                <field name="move_id"/>
                <field name="investra_instrument_id"/>
                <field name="investra_class_label"/>
                <field name="investra_source_name"/>
                <button name="action_open_source" type="object" icon="fa-external-link" string="Otevřít zdroj"/>
                <field name="name" optional="show"/>
                <field name="balance" sum="Částka"/>
            </list>
        </field>
    </record>
</odoo>
