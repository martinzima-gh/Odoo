<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dividend_list" model="ir.ui.view">
        <field name="name">investra.dividend.list</field>
        <field name="model">investra.dividend</field>
        <field name="arch" type="xml">
            <list default_order="ex_date desc, id desc">
                <field name="ex_date"/>
                <field name="pay_date" optional="show"/>
                <field name="fund_id"/>
                <field name="instrument_id"/>
                <field name="portfolio_id" optional="show"/>
                <field name="kind"/>
                <field name="gross_amount" sum="Celkem"/>
                <field name="withheld_amount" optional="show" sum="Celkem"/>
                <field name="net_amount" optional="show" sum="Celkem"/>
                <field name="currency_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state in ('booked', 'paid')"
                       decoration-muted="state == 'reversed'"/>
            </list>
        </field>
    </record>
    <record id="view_dividend_search" model="ir.ui.view">
        <field name="name">investra.dividend.search</field>
        <field name="model">investra.dividend</field>
        <field name="arch" type="xml">
            <search>
                <field name="fund_id"/>
                <field name="instrument_id"/>
                <field name="portfolio_id"/>
                <field name="ex_date"/>
                <filter name="filter_draft" string="Návrh" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_booked" string="Zaúčtováno k ex-datu" domain="[('state', '=', 'booked')]"/>
                <filter name="filter_paid" string="Vyplaceno" domain="[('state', '=', 'paid')]"/>
                <filter name="filter_reversed" string="Stornováno" domain="[('state', '=', 'reversed')]"/>
                <separator/>
                <filter name="filter_ex_date" date="ex_date" string="Ex-datum"/>
                <group>
                    <filter name="group_by_fund" string="Fond" context="{'group_by': 'fund_id'}"/>
                    <filter name="group_by_instrument" string="Nástroj" context="{'group_by': 'instrument_id'}"/>
                    <filter name="group_by_state" string="Stav" context="{'group_by': 'state'}"/>
                    <filter name="group_by_ex_date_month" string="Měsíc ex-datumu" context="{'group_by': 'ex_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_dividend_form" model="ir.ui.view">
        <field name="name">investra.dividend.form</field>
        <field name="model">investra.dividend</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_book" type="object" string="Zaúčtovat" class="btn-primary"
                            invisible="state != 'draft'" groups="investra_entity.group_valuation_preparer"/>
                    <button name="action_pay" type="object" string="Zaplaceno" class="btn-primary"
                            invisible="state != 'booked'" groups="investra_entity.group_valuation_preparer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,booked,paid,reversed"/>
                </header>
                <sheet>
                    <field name="allowed_portfolio_ids" invisible="1"/>
                    <field name="foreign_currency" invisible="1"/>
                    <field name="portfolio_class_id" invisible="1"/>
                    <div class="alert alert-danger" role="alert" invisible="state != 'reversed'">
                        Dividenda je stornovaná. Důvod: <field name="reversal_reason" readonly="1" class="oe_inline"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="instrument_id" readonly="state != 'draft'"/></h1>
                    </div>
                    <group>
                        <group string="Nárok">
                            <field name="fund_id" readonly="state != 'draft'"/>
                            <field name="portfolio_id" domain="[('id', 'in', allowed_portfolio_ids)]"
                                   options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="ex_date" readonly="state != 'draft'"/>
                            <field name="units" readonly="state != 'draft'"/>
                            <field name="per_share" readonly="state != 'draft'"/>
                            <field name="gross_amount" readonly="1"/>
                        </group>
                        <group string="Výplata">
                            <field name="pay_date" readonly="state in ('paid', 'reversed')"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="fx_rate" invisible="not foreign_currency" readonly="state != 'draft'"/>
                            <field name="pay_fx_rate" invisible="not foreign_currency" readonly="state in ('paid', 'reversed')"/>
                            <field name="net_amount" readonly="1"/>
                        </group>
                    </group>
                    <group string="Srážka a zápočet">
                        <group>
                            <field name="kind" string="Druh" readonly="state != 'draft'"/>
                            <field name="withholding_rate" readonly="state != 'draft'"/>
                            <field name="withheld_amount" readonly="state != 'draft'"/>
                            <field name="treaty_rate" invisible="kind != 'foreign'" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="creditable_amount" readonly="state != 'draft'"/>
                            <field name="excess_amount" invisible="kind != 'foreign'" readonly="1"/>
                            <field name="excess_treatment" invisible="kind != 'foreign'" readonly="state != 'draft'"/>
                            <field name="note" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Zaúčtování" invisible="not event_id and not pay_event_id">
                        <field name="event_id" readonly="1" invisible="not event_id"/>
                        <field name="pay_event_id" readonly="1" invisible="not pay_event_id"/>
                    </group>
                    <notebook invisible="not posting_preview">
                        <page name="posting_preview" string="Zaúčtování">
                            <field name="posting_preview" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_dividend" model="ir.actions.act_window">
        <field name="name">Dividendy</field>
        <field name="res_model">investra.dividend</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dividend_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Zatím tu není žádná dividenda</p>
            <p>Dividenda patří fondu a portfoliu, které drželo nástroj k večeru dne před ex-datem. Zaúčtuje se k ex-datu; výplata se zaznamená tlačítkem Zaplaceno.</p>
        </field>
    </record>
    <record id="view_instrument_form_dividend" model="ir.ui.view">
        <field name="name">investra.instrument.form.dividend</field>
        <field name="model">investra.instrument</field>
        <field name="inherit_id" ref="investra_instruments.view_instrument_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="%(action_dividend)d" type="action" class="oe_stat_button" icon="fa-money"
                            context="{'search_default_instrument_id': id, 'default_instrument_id': id}">
                        <div class="o_stat_info"><span class="o_stat_text">Dividendy</span></div>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
    <menuitem id="menu_dividend" name="Dividendy" parent="investra_instruments.menu_instruments"
              action="action_dividend" sequence="30"/>
</odoo>
