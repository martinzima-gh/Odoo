# Zkopirujte do .env a doplnte hodnoty. Soubor .env se neverzuje.
# Heslo PostgreSQL vyukove instance (docker-compose.yml).
ODOO_DB_PASSWORD=
# Heslo PostgreSQL vyvojove instance Investra (docker-compose.investra.yml).
INVESTRA_DB_PASSWORD=
# Heslo uzivatele admin v databazi investra_dev. Compose ho nepouziva, slouzi jen
# jako misto pro ulozeni. Spravce databazi je vypnuty (--no-database-list),
# master heslo (admin_passwd) proto neni potreba.
INVESTRA_ADMIN_PASSWORD=
